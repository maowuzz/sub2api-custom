+func TestAllocateListenerPortCastsGenerateSeriesParameters(t *testing.T) {
+	t.Parallel()
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+
+	mock.ExpectBegin()
+	tx, err := db.BeginTx(context.Background(), nil)
+	if err != nil {
+		t.Fatalf("BeginTx: %v", err)
+	}
+	mock.ExpectQuery(`generate_series\(\$1::integer,\$2::integer\)`).
+		WithArgs(proxySubscriptionMinPort, proxySubscriptionMaxPort).
+		WillReturnRows(sqlmock.NewRows([]string{"p"}).AddRow(proxySubscriptionMinPort))
+
+	port, err := allocateListenerPort(context.Background(), tx)
+	if err != nil {
+		t.Fatalf("allocateListenerPort: %v", err)
+	}
+	if port != proxySubscriptionMinPort {
+		t.Fatalf("port = %d, want %d", port, proxySubscriptionMinPort)
+	}
+	if err := mock.ExpectationsWereMet(); err != nil {
+		t.Fatalf("unmet SQL expectations: %v", err)
+	}
+}
+
+func TestGetProviderNodesUsesMihomoProviderRoute(t *testing.T) {
+	t.Parallel()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/providers/proxies/candidate-1/" {
+			t.Fatalf("provider route = %q, want trailing slash provider route", r.URL.Path)
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"name":    "candidate-1",
+			"proxies": []mihomoProviderProxy{{Name: "Tokyo", Type: "VLESS", Alive: true}},
+		})
+	}))
+	t.Cleanup(server.Close)
+
+	service := &ProxySubscriptionService{mihomoURL: server.URL, mihomoClient: server.Client()}
+	nodes, err := service.getProviderNodes(context.Background(), "candidate-1")
+	if err != nil {
+		t.Fatalf("getProviderNodes() error = %v", err)
+	}
+	if len(nodes) != 1 || nodes[0].Name != "Tokyo" {
+		t.Fatalf("unexpected provider nodes: %#v", nodes)
+	}
+}
+
+func TestProviderRevisionURLOutlivesMihomoRefreshInterval(t *testing.T) {
+	t.Parallel()
+	service := &ProxySubscriptionService{
+		internalBase: "http://sub2api:8081",
+		hmacSecret:   []byte("0123456789abcdef0123456789abcdef"),
+	}
+	config := service.providerConfig(7)
+	rawURL, ok := config["url"].(string)
+	if !ok {
+		t.Fatalf("provider url has unexpected type: %T", config["url"])
+	}
+	parsed, err := url.Parse(rawURL)
+	if err != nil {
+		t.Fatalf("parse provider url: %v", err)
+	}
+	expires, err := strconv.ParseInt(parsed.Query().Get("expires"), 10, 64)
+	if err != nil {
+		t.Fatalf("parse provider expiry: %v", err)
+	}
+	interval, ok := config["interval"].(int)
+	if !ok {
+		t.Fatalf("provider interval has unexpected type: %T", config["interval"])
+	}
+	if expires-time.Now().Unix() <= int64(interval) {
+		t.Fatalf("provider url expires before the next refresh: expires=%d interval=%d", expires, interval)
+	}
+}
+
+func TestValidateSubscriptionURL(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		raw     string
+		wantErr bool
+	}{
+		{name: "public https", raw: "https://example.com/sub?token=secret"},
+		{name: "public http", raw: "http://1.1.1.1/sub"},
+		{name: "loopback", raw: "http://127.0.0.1/sub", wantErr: true},
+		{name: "rfc1918", raw: "https://10.1.2.3/sub", wantErr: true},
+		{name: "link local", raw: "http://169.254.169.254/latest", wantErr: true},
+		{name: "userinfo", raw: "https://user:pass@example.com/sub", wantErr: true},
+		{name: "file", raw: "file:///etc/passwd", wantErr: true},
+	}
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			parsed, err := url.Parse(test.raw)
+			if err == nil {
+				err = validateSubscriptionURL(parsed)
+			}
+			if (err != nil) != test.wantErr {
+				t.Fatalf("validateSubscriptionURL(%q) error = %v, wantErr %v", test.raw, err, test.wantErr)
+			}
+		})
+	}
+}
+
+func TestIsPublicSubscriptionIP(t *testing.T) {
+	t.Parallel()
+	for _, raw := range []string{
+		"127.0.0.1", "10.0.0.1", "172.16.0.1", "192.168.1.1", "169.254.169.254",
+		"100.64.0.1", "192.0.2.1", "198.18.0.1", "198.51.100.1", "203.0.113.1",
+		"::1", "fc00::1", "2001:db8::1",
+	} {
+		if isPublicSubscriptionIP(net.ParseIP(raw)) {
+			t.Fatalf("private/special IP %s accepted", raw)
+		}
+	}
+	for _, raw := range []string{"1.1.1.1", "8.8.8.8", "2606:4700:4700::1111"} {
+		if !isPublicSubscriptionIP(net.ParseIP(raw)) {
+			t.Fatalf("public IP %s rejected", raw)
+		}
+	}
+}
+
+func TestRedactSubscriptionErrorRemovesURLSecrets(t *testing.T) {
+	t.Parallel()
+	redacted := redactSubscriptionError(errors.New("Get https://sub.example.com/api/subscribe/token-value?token=very-secret: timeout"))
+	if strings.Contains(redacted, "token-value") || strings.Contains(redacted, "very-secret") || strings.Contains(redacted, "token=") {
+		t.Fatalf("redacted error leaked subscription credentials: %s", redacted)
+	}
+}
+
+func TestMaskSubscriptionURLRemovesSecrets(t *testing.T) {
+	t.Parallel()
+	masked := maskSubscriptionURL("https://sub.example.com/api/v1/client/subscribe?token=very-secret#fragment")
+	if strings.Contains(masked, "very-secret") || strings.Contains(masked, "token=") || strings.Contains(masked, "fragment") {
+		t.Fatalf("masked URL leaked secret material: %s", masked)
+	}
+	if masked != "https://sub.example.com/api/v1/client/***" {
+		t.Fatalf("unexpected masked URL: %s", masked)
+	}
+}
+
+func TestFilterProviderNodesExcludeWins(t *testing.T) {
+	t.Parallel()
+	nodes := []mihomoProviderProxy{
+		{Name: "Hong Kong Premium", Type: "VLESS", Alive: true},
+		{Name: "Hong Kong Remaining Traffic", Type: "SS", Alive: true},
+		{Name: "Tokyo", Type: "Trojan", Alive: true},
+		{Name: "hong kong premium", Type: "vless", Alive: true},
+	}
+	filtered := filterProviderNodes(nodes, []string{"hong kong"}, []string{"traffic"})
+	if len(filtered) != 1 || filtered[0].Name != "Hong Kong Premium" {
+		t.Fatalf("unexpected filtered nodes: %#v", filtered)
+	}
+}
+
+func TestNodeStableKeyIsCaseInsensitiveAndProtocolSpecific(t *testing.T) {
+	t.Parallel()
+	a := nodeStableKey(mihomoProviderProxy{Name: "Tokyo 01", Type: "VLESS"})
+	b := nodeStableKey(mihomoProviderProxy{Name: "tokyo 01", Type: "vless"})
+	c := nodeStableKey(mihomoProviderProxy{Name: "Tokyo 01", Type: "Trojan"})
+	if a != b {
+		t.Fatal("case-only changes should preserve the stable key")
+	}
+	if a == c {
+		t.Fatal("protocol changes must produce a different stable key")
+	}
+}
