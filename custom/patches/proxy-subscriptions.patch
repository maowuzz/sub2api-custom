+type proxySubscriptionRevision struct {
+	ID             int64
+	SubscriptionID int64
+	Encrypted      string
+	ETag           string
+	LastModified   string
+}
+
+type mihomoProviderProxy struct {
+	Name  string `json:"name"`
+	Type  string `json:"type"`
