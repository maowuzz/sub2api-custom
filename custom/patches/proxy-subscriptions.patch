+func (s *ProxySubscriptionService) PreviewBalance(ctx context.Context, adminID int64, accountIDs []int64) (*ProxyBalancePreview, error) {
+	preview, err := s.buildBalancePreview(ctx, accountIDs)
+	if err != nil {
+		return nil, err
+	}
+	planID, err := proxySubscriptionRandomHex(16)
+	if err != nil {
+		return nil, err
+	}
+	preview.PlanID = planID
+	preview.ExpiresAt = time.Now().Add(proxySubscriptionPlanTTL)
+	payload, err := json.Marshal(preview)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.redis.Set(ctx, balancePlanKey(adminID, planID), payload, proxySubscriptionPlanTTL).Err(); err != nil {
+		return nil, err
+	}
+	return preview, nil
+}
+
+func (s *ProxySubscriptionService) buildBalancePreview(ctx context.Context, accountIDs []int64) (*ProxyBalancePreview, error) {
+	nodes, err := s.availableBalanceNodes(ctx)
+	if err != nil {
+		return nil, err
+	}
+	preview := &ProxyBalancePreview{ExpectedLoad: make(map[int64]int)}
+	if len(nodes) == 0 {
+		preview.Unassigned = len(accountIDs)
+		return preview, nil
+	}
+	for _, node := range nodes {
+		preview.ExpectedLoad[node.ID] = node.AssignedAccountCount
+	}
+	accountIDs = uniquePositiveInt64sForSubscription(accountIDs)
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT a.id, a.subscription_proxy_node_id, a.proxy_id, a.subscription_proxy_mode
+		FROM accounts a WHERE a.deleted_at IS NULL AND a.id=ANY($1) ORDER BY a.id
+	`, int64Array(accountIDs))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	available := make(map[int64]ProxySubscriptionNode, len(nodes))
+	for _, node := range nodes {
+		available[node.ID] = node
+	}
+	for rows.Next() {
+		var accountID int64
+		var current sql.NullInt64
+		var currentProxy sql.NullInt64
+		var currentMode sql.NullString
+		if err := rows.Scan(&accountID, &current, &currentProxy, &currentMode); err != nil {
+			return nil, err
+		}
+		var currentProxyID *int64
+		if currentProxy.Valid {
+			v := currentProxy.Int64
+			currentProxyID = &v
+		}
+		var currentModeValue *string
+		if currentMode.Valid {
+			v := currentMode.String
+			currentModeValue = &v
+		}
+		if current.Valid {
+			if node, ok := available[current.Int64]; ok {
+				id := current.Int64
+				preview.Assignments = append(preview.Assignments, ProxyBalanceAssignment{AccountID: accountID, CurrentNodeID: &id, CurrentProxyID: currentProxyID, CurrentMode: currentModeValue, TargetNodeID: id, TargetProxyID: node.ProxyID, TargetNodeName: node.DisplayName, Kept: true})
+				preview.Kept++
+				continue
+			}
+		}
+		target := nodes[0]
+		for _, candidate := range nodes[1:] {
+			if preview.ExpectedLoad[candidate.ID] < preview.ExpectedLoad[target.ID] ||
+				(preview.ExpectedLoad[candidate.ID] == preview.ExpectedLoad[target.ID] && candidate.ID < target.ID) {
+				target = candidate
+			}
+		}
+		preview.ExpectedLoad[target.ID]++
+		assignment := ProxyBalanceAssignment{AccountID: accountID, TargetNodeID: target.ID, TargetProxyID: target.ProxyID, TargetNodeName: target.DisplayName}
+		assignment.CurrentProxyID = currentProxyID
+		assignment.CurrentMode = currentModeValue
+		if current.Valid {
+			v := current.Int64
+			assignment.CurrentNodeID = &v
+		}
+		preview.Assignments = append(preview.Assignments, assignment)
+		preview.Moved++
+	}
+	return preview, rows.Err()
+}
+
+func (s *ProxySubscriptionService) availableBalanceNodes(ctx context.Context) ([]ProxySubscriptionNode, error) {
+	nodes, err := s.Nodes(ctx, 0)
+	if err != nil {
+		return nil, err
+	}
+	result := nodes[:0]
+	for _, node := range nodes {
+		if node.HealthStatus == "healthy" || node.HealthStatus == "unknown" {
+			result = append(result, node)
+		}
+	}
+	return result, nil
+}
+
+func balancePlanKey(adminID int64, planID string) string {
+	return fmt.Sprintf("proxy-subscription:balance-plan:%d:%s", adminID, planID)
+}
+
+func rollbackPlanKey(adminID int64, planID string) string {
+	return fmt.Sprintf("proxy-subscription:rollback-plan:%d:%s", adminID, planID)
+}
+
+func (s *ProxySubscriptionService) ApplyBalance(ctx context.Context, adminID int64, planID string) (*ProxyBalancePreview, error) {
+	key := balancePlanKey(adminID, strings.TrimSpace(planID))
+	payload, err := s.redis.GetDel(ctx, key).Bytes()
+	if err != nil {
+		return nil, infraerrors.BadRequest("PROXY_BALANCE_PLAN_EXPIRED", "balance preview expired or does not belong to this administrator")
+	}
+	var preview ProxyBalancePreview
+	if err := json.Unmarshal(payload, &preview); err != nil {
+		return nil, err
+	}
+	if err := s.validateBalancePreview(ctx, preview.Assignments); err != nil {
+		return nil, err
+	}
+	if err := s.applyAssignments(ctx, preview.Assignments, "auto"); err != nil {
+		return nil, err
+	}
+	return &preview, nil
+}
+
+func (s *ProxySubscriptionService) validateBalancePreview(ctx context.Context, assignments []ProxyBalanceAssignment) error {
+	if len(assignments) == 0 {
+		return nil
+	}
+	ids := make([]int64, 0, len(assignments))
+	nodeIDs := make([]int64, 0, len(assignments))
+	for _, assignment := range assignments {
+		ids = append(ids, assignment.AccountID)
+		nodeIDs = append(nodeIDs, assignment.TargetNodeID)
+	}
+	rows, err := s.db.QueryContext(ctx, `SELECT id, subscription_proxy_node_id, proxy_id, subscription_proxy_mode FROM accounts WHERE id=ANY($1) AND deleted_at IS NULL`, int64Array(ids))
+	if err != nil {
+		return err
+	}
+	type currentAssignment struct {
+		nodeID, proxyID sql.NullInt64
+		mode            sql.NullString
+	}
+	current := make(map[int64]currentAssignment, len(ids))
+	for rows.Next() {
+		var id int64
+		var value currentAssignment
+		if err := rows.Scan(&id, &value.nodeID, &value.proxyID, &value.mode); err != nil {
+			rows.Close()
+			return err
+		}
+		current[id] = value
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	nodeRows, err := s.db.QueryContext(ctx, `SELECT id, proxy_id, health_status FROM proxy_subscription_nodes WHERE id=ANY($1)`, int64Array(uniquePositiveInt64sForSubscription(nodeIDs)))
+	if err != nil {
+		return err
+	}
+	type nodeState struct {
+		proxyID int64
+		health  string
+	}
+	nodes := make(map[int64]nodeState, len(nodeIDs))
+	for nodeRows.Next() {
+		var id int64
+		var state nodeState
+		if err := nodeRows.Scan(&id, &state.proxyID, &state.health); err != nil {
+			nodeRows.Close()
+			return err
+		}
+		nodes[id] = state
+	}
+	if err := nodeRows.Err(); err != nil {
+		nodeRows.Close()
+		return err
+	}
+	nodeRows.Close()
+	for _, assignment := range assignments {
+		state, ok := current[assignment.AccountID]
+		if !ok {
+			return infraerrors.Conflict("PROXY_BALANCE_PLAN_STALE", "an account changed after the balance preview")
+		}
+		if !nullableIDsEqual(state.nodeID, assignment.CurrentNodeID) || !nullableIDsEqual(state.proxyID, assignment.CurrentProxyID) {
+			return infraerrors.Conflict("PROXY_BALANCE_PLAN_STALE", "an account changed after the balance preview")
+		}
+		if !nullableStringsEqual(state.mode, assignment.CurrentMode) {
+			return infraerrors.Conflict("PROXY_BALANCE_PLAN_STALE", "an account assignment mode changed after the balance preview")
+		}
+		node, ok := nodes[assignment.TargetNodeID]
+		if !ok || node.proxyID != assignment.TargetProxyID || (node.health != "healthy" && node.health != "unknown") {
+			return infraerrors.Conflict("PROXY_BALANCE_PLAN_STALE", "a target subscription node changed after the balance preview")
+		}
+	}
+	return nil
+}
+
+func nullableIDsEqual(current sql.NullInt64, expected *int64) bool {
+	if expected == nil {
+		return !current.Valid
+	}
+	return current.Valid && current.Int64 == *expected
+}
+
+func nullableStringsEqual(current sql.NullString, expected *string) bool {
+	if expected == nil {
+		return !current.Valid
+	}
+	return current.Valid && current.String == *expected
+}
+
+func (s *ProxySubscriptionService) AssignManual(ctx context.Context, accountIDs []int64, nodeID int64) error {
+	var proxyID int64
+	var name string
+	var health string
+	var enabled bool
+	if err := s.db.QueryRowContext(ctx, `
+		SELECT n.proxy_id, n.display_name, n.health_status, s.enabled
+		FROM proxy_subscription_nodes n JOIN proxy_subscriptions s ON s.id=n.subscription_id
+		WHERE n.id=$1
+	`, nodeID).Scan(&proxyID, &name, &health, &enabled); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return ErrProxySubscriptionInvalid
+		}
+		return err
+	}
+	if !enabled || (health != "healthy" && health != "unknown") {
+		return infraerrors.Conflict("PROXY_SUBSCRIPTION_NODE_UNAVAILABLE", "subscription node is disabled or unhealthy")
+	}
+	assignments := make([]ProxyBalanceAssignment, 0, len(accountIDs))
+	for _, accountID := range uniquePositiveInt64sForSubscription(accountIDs) {
+		assignments = append(assignments, ProxyBalanceAssignment{AccountID: accountID, TargetNodeID: nodeID, TargetProxyID: proxyID, TargetNodeName: name})
+	}
+	return s.applyAssignments(ctx, assignments, "manual")
+}
+
+func (s *ProxySubscriptionService) applyAssignments(ctx context.Context, assignments []ProxyBalanceAssignment, mode string) error {
+	if len(assignments) == 0 {
+		return nil
+	}
+	if mode != "manual" && mode != "auto" {
+		return errors.New("invalid subscription assignment mode")
+	}
+	values := make([]string, 0, len(assignments))
+	args := make([]any, 0, len(assignments)*6+1)
+	for i, assignment := range assignments {
+		base := i*6 + 1
+		values = append(values, fmt.Sprintf("($%d::bigint,$%d::bigint,$%d::bigint,$%d::bigint,$%d::bigint,$%d::text)", base, base+1, base+2, base+3, base+4, base+5))
+		args = append(args, assignment.AccountID, assignment.TargetProxyID, assignment.TargetNodeID,
+			nullableInt64(assignment.CurrentNodeID), nullableInt64(assignment.CurrentProxyID), nullableString(assignment.CurrentMode))
+	}
+	args = append(args, mode)
+	modeParam := len(args)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	query := fmt.Sprintf(`
+		UPDATE accounts a
+		SET subscription_previous_proxy_id=CASE
+				WHEN a.subscription_proxy_node_id IS NULL THEN a.proxy_id
+				ELSE a.subscription_previous_proxy_id END,
+			proxy_id=v.proxy_id, subscription_proxy_node_id=v.node_id,
+			subscription_proxy_mode=$%d, proxy_fallback_origin_id=NULL, updated_at=NOW()
+		FROM (VALUES %s) AS v(account_id,proxy_id,node_id,current_node_id,current_proxy_id,current_mode)
+		WHERE a.id=v.account_id AND a.deleted_at IS NULL
+		  AND ($%d <> 'auto' OR (
+				((v.current_node_id IS NULL AND a.subscription_proxy_node_id IS NULL) OR v.current_node_id=a.subscription_proxy_node_id)
+			AND ((v.current_proxy_id IS NULL AND a.proxy_id IS NULL) OR v.current_proxy_id=a.proxy_id)
+			AND ((v.current_mode IS NULL AND a.subscription_proxy_mode IS NULL) OR v.current_mode=a.subscription_proxy_mode)
+		  ))
+	`, modeParam, strings.Join(values, ","), modeParam)
+	result, err := tx.ExecContext(ctx, query, args...)
+	if err != nil {
+		return err
+	}
+	if mode == "auto" {
+		if affected, rowsErr := result.RowsAffected(); rowsErr != nil || affected != int64(len(assignments)) {
+			return infraerrors.Conflict("PROXY_BALANCE_PLAN_STALE", "an account changed after the balance preview")
+		}
+	}
+	ids := make([]int64, 0, len(assignments))
+	for _, assignment := range assignments {
+		ids = append(ids, assignment.AccountID)
+	}
+	payload, _ := json.Marshal(map[string]any{"account_ids": ids})
+	if _, err := tx.ExecContext(ctx, `INSERT INTO scheduler_outbox(event_type,payload) VALUES($1,$2::jsonb)`, SchedulerOutboxEventAccountBulkChanged, payload); err != nil {
+		return err
+	}
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+	s.refreshSchedulerSnapshots(context.WithoutCancel(ctx), ids)
+	return nil
+}
+
+func (s *ProxySubscriptionService) refreshSchedulerSnapshots(ctx context.Context, ids []int64) {
+	if s.accountRepo == nil || s.schedulerCache == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	accounts, err := s.accountRepo.GetByIDs(ctx, ids)
+	if err != nil {
+		return
+	}
+	for _, account := range accounts {
+		if account != nil {
+			_ = s.schedulerCache.SetAccount(ctx, account)
+		}
+	}
+}
+
+func (s *ProxySubscriptionService) PreviewRollback(ctx context.Context, adminID int64, subscriptionID *int64) (*ProxyRollbackPreview, error) {
+	query := `
+		SELECT a.id, a.subscription_previous_proxy_id, a.proxy_id, a.subscription_proxy_node_id, a.subscription_proxy_mode
+		FROM accounts a
+		JOIN proxy_subscription_nodes n ON n.id=a.subscription_proxy_node_id
+		WHERE a.deleted_at IS NULL AND ($1::bigint IS NULL OR n.subscription_id=$1)
+		ORDER BY a.id
+	`
+	rows, err := s.db.QueryContext(ctx, query, nullableInt64(subscriptionID))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	preview := &ProxyRollbackPreview{}
+	for rows.Next() {
+		var accountID int64
+		var previous sql.NullInt64
+		var currentProxy, currentNode sql.NullInt64
+		var currentMode sql.NullString
+		if err := rows.Scan(&accountID, &previous, &currentProxy, &currentNode, &currentMode); err != nil {
+			return nil, err
+		}
+		assignment := ProxyRollbackAssignment{AccountID: accountID}
+		if currentProxy.Valid {
+			value := currentProxy.Int64
+			assignment.CurrentProxyID = &value
+		}
+		if currentNode.Valid {
+			value := currentNode.Int64
+			assignment.CurrentNodeID = &value
+		}
+		if currentMode.Valid {
+			value := currentMode.String
+			assignment.CurrentMode = &value
+		}
+		if previous.Valid {
+			v := previous.Int64
+			assignment.ProxyID = &v
+			preview.Restored++
+		} else {
+			preview.Cleared++
+		}
+		preview.Assignments = append(preview.Assignments, assignment)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	planID, err := proxySubscriptionRandomHex(16)
+	if err != nil {
+		return nil, err
+	}
+	preview.PlanID = planID
+	preview.ExpiresAt = time.Now().Add(proxySubscriptionPlanTTL)
+	payload, err := json.Marshal(preview)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.redis.Set(ctx, rollbackPlanKey(adminID, planID), payload, proxySubscriptionPlanTTL).Err(); err != nil {
+		return nil, err
+	}
+	return preview, nil
+}
+
+func (s *ProxySubscriptionService) ApplyRollback(ctx context.Context, adminID int64, planID string) (*ProxyRollbackPreview, error) {
+	key := rollbackPlanKey(adminID, strings.TrimSpace(planID))
+	payload, err := s.redis.GetDel(ctx, key).Bytes()
+	if err != nil {
+		return nil, infraerrors.BadRequest("PROXY_ROLLBACK_PLAN_EXPIRED", "rollback preview expired or does not belong to this administrator")
+	}
+	var preview ProxyRollbackPreview
+	if err := json.Unmarshal(payload, &preview); err != nil {
+		return nil, err
+	}
+	if len(preview.Assignments) == 0 {
+		return &preview, nil
+	}
+	values := make([]string, 0, len(preview.Assignments))
+	args := make([]any, 0, len(preview.Assignments)*5)
+	ids := make([]int64, 0, len(preview.Assignments))
+	for i, assignment := range preview.Assignments {
+		base := i*5 + 1
+		values = append(values, fmt.Sprintf("($%d::bigint,$%d::bigint,$%d::bigint,$%d::bigint,$%d::text)", base, base+1, base+2, base+3, base+4))
+		args = append(args, assignment.AccountID, nullableInt64(assignment.ProxyID), nullableInt64(assignment.CurrentNodeID), nullableInt64(assignment.CurrentProxyID), nullableString(assignment.CurrentMode))
+		ids = append(ids, assignment.AccountID)
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	query := fmt.Sprintf(`
+		UPDATE accounts a SET proxy_id=v.proxy_id, subscription_proxy_mode=NULL,
+			subscription_proxy_node_id=NULL, subscription_previous_proxy_id=NULL,
+			proxy_fallback_origin_id=NULL, updated_at=NOW()
+		FROM (VALUES %s) AS v(account_id,proxy_id,current_node_id,current_proxy_id,current_mode)
+		WHERE a.id=v.account_id AND a.deleted_at IS NULL
+		  AND ((v.current_node_id IS NULL AND a.subscription_proxy_node_id IS NULL) OR v.current_node_id=a.subscription_proxy_node_id)
+		  AND ((v.current_proxy_id IS NULL AND a.proxy_id IS NULL) OR v.current_proxy_id=a.proxy_id)
+		  AND ((v.current_mode IS NULL AND a.subscription_proxy_mode IS NULL) OR v.current_mode=a.subscription_proxy_mode)
+	`, strings.Join(values, ","))
+	result, err := tx.ExecContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	if affected, rowsErr := result.RowsAffected(); rowsErr != nil || affected != int64(len(preview.Assignments)) {
+		return nil, infraerrors.Conflict("PROXY_ROLLBACK_PLAN_STALE", "an account changed after the rollback preview")
+	}
+	outboxPayload, _ := json.Marshal(map[string]any{"account_ids": ids})
+	if _, err := tx.ExecContext(ctx, `INSERT INTO scheduler_outbox(event_type,payload) VALUES($1,$2::jsonb)`, SchedulerOutboxEventAccountBulkChanged, outboxPayload); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	s.refreshSchedulerSnapshots(context.WithoutCancel(ctx), ids)
+	return &preview, nil
+}
+
+func nullableInt64(value *int64) any {
+	if value == nil {
+		return nil
+	}
+	return *value
+}
+
+func nullableString(value *string) any {
+	if value == nil {
+		return nil
+	}
+	return *value
+}
+
+type int64Array []int64
+
+func (a int64Array) Value() (driver.Value, error) {
+	if len(a) == 0 {
+		return "{}", nil
+	}
+	parts := make([]string, len(a))
+	for i, value := range a {
+		parts[i] = strconv.FormatInt(value, 10)
+	}
+	return "{" + strings.Join(parts, ",") + "}", nil
+}
+
+func uniquePositiveInt64sForSubscription(ids []int64) []int64 {
+	seen := make(map[int64]struct{}, len(ids))
+	result := make([]int64, 0, len(ids))
+	for _, id := range ids {
+		if id <= 0 {
+			continue
+		}
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		result = append(result, id)
+	}
+	return result
+}
+
+type ProxySubscriptionMetadata struct {
+	NodeID           int64
+	SubscriptionID   int64
+	SubscriptionName string
+}
+
+type AccountProxySubscriptionMetadata struct {
+	Mode            string
+	NodeID          int64
+	SubscriptionID  int64
+	PreviousProxyID *int64
+}
+
+func (s *ProxySubscriptionService) AccountMetadata(ctx context.Context, accountIDs []int64) (map[int64]AccountProxySubscriptionMetadata, error) {
+	accountIDs = uniquePositiveInt64sForSubscription(accountIDs)
+	result := make(map[int64]AccountProxySubscriptionMetadata, len(accountIDs))
+	if len(accountIDs) == 0 {
+		return result, nil
+	}
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT a.id, a.subscription_proxy_mode, a.subscription_proxy_node_id,
+			n.subscription_id, a.subscription_previous_proxy_id
+		FROM accounts a
+		JOIN proxy_subscription_nodes n ON n.id=a.subscription_proxy_node_id
+		WHERE a.id=ANY($1) AND a.deleted_at IS NULL
+	`, int64Array(accountIDs))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var accountID int64
+		var meta AccountProxySubscriptionMetadata
+		var previous sql.NullInt64
+		if err := rows.Scan(&accountID, &meta.Mode, &meta.NodeID, &meta.SubscriptionID, &previous); err != nil {
+			return nil, err
+		}
+		if previous.Valid {
+			v := previous.Int64
+			meta.PreviousProxyID = &v
+		}
+		result[accountID] = meta
+	}
+	return result, rows.Err()
+}
+
+func (s *ProxySubscriptionService) ProxyMetadata(ctx context.Context, proxyIDs []int64) (map[int64]ProxySubscriptionMetadata, error) {
+	proxyIDs = uniquePositiveInt64sForSubscription(proxyIDs)
+	result := make(map[int64]ProxySubscriptionMetadata, len(proxyIDs))
+	if len(proxyIDs) == 0 {
+		return result, nil
+	}
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT n.proxy_id, n.id, s.id, s.name
+		FROM proxy_subscription_nodes n JOIN proxy_subscriptions s ON s.id=n.subscription_id
+		WHERE n.proxy_id=ANY($1)
+	`, int64Array(proxyIDs))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var proxyID int64
+		var meta ProxySubscriptionMetadata
+		if err := rows.Scan(&proxyID, &meta.NodeID, &meta.SubscriptionID, &meta.SubscriptionName); err != nil {
+			return nil, err
+		}
+		result[proxyID] = meta
+	}
+	return result, rows.Err()
+}
