+
+func (h *ProxySubscriptionHandler) AssignManual(c *gin.Context) {
+	var request struct {
+		AccountIDs []int64                           `json:"account_ids"`
+		Filters    *service.BulkUpdateAccountFilters `json:"filters"`
+		NodeID     int64                             `json:"node_id" binding:"required,min=1"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil {
+		response.BadRequest(c, "Invalid request: "+err.Error())
+		return
+	}
+	accountIDs, err := h.resolveAccountIDs(c, request.AccountIDs, request.Filters)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	if len(accountIDs) == 0 {
+		response.BadRequest(c, "No accounts selected")
+		return
+	}
+	if err := h.service.AssignManual(c.Request.Context(), accountIDs, request.NodeID); err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, gin.H{"updated": len(accountIDs)})
+}
+
+func (h *ProxySubscriptionHandler) PreviewBalance(c *gin.Context) {
+	var request struct {
+		AccountIDs []int64                           `json:"account_ids"`
+		Filters    *service.BulkUpdateAccountFilters `json:"filters"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil {
+		response.BadRequest(c, "Invalid request: "+err.Error())
+		return
+	}
+	accountIDs, err := h.resolveAccountIDs(c, request.AccountIDs, request.Filters)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	if len(accountIDs) == 0 {
+		response.BadRequest(c, "No accounts selected")
+		return
+	}
+	preview, err := h.service.PreviewBalance(c.Request.Context(), adminUserID(c), accountIDs)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, preview)
+}
+
+func (h *ProxySubscriptionHandler) resolveAccountIDs(c *gin.Context, accountIDs []int64, filters *service.BulkUpdateAccountFilters) ([]int64, error) {
+	if len(accountIDs) == 0 && filters != nil {
+		groupID := int64(0)
+		if filters.Group == "ungrouped" {
+			groupID = service.AccountListGroupUngrouped
+		} else if filters.Group != "" {
+			groupID, _ = strconv.ParseInt(filters.Group, 10, 64)
+		}
+		accounts, listErr := h.adminService.ListAccountsForSchedulerScoreFilter(c.Request.Context(),
+			filters.Platform, filters.Type, filters.Status,
+			filters.Search, groupID, filters.PrivacyMode)
+		if listErr != nil {
+			return nil, listErr
+		}
+		for i := range accounts {
+			accountIDs = append(accountIDs, accounts[i].ID)
+		}
+	}
+	return accountIDs, nil
+}
+
+func (h *ProxySubscriptionHandler) ApplyBalance(c *gin.Context) {
+	var request struct {
+		PlanID string `json:"plan_id" binding:"required"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil {
+		response.BadRequest(c, "Invalid request: "+err.Error())
+		return
+	}
+	result, err := h.service.ApplyBalance(c.Request.Context(), adminUserID(c), request.PlanID)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, result)
+}
+
+func (h *ProxySubscriptionHandler) PreviewRollback(c *gin.Context) {
+	var request struct {
+		SubscriptionID *int64 `json:"subscription_id"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil && !strings.Contains(err.Error(), "EOF") {
+		response.BadRequest(c, "Invalid request: "+err.Error())
+		return
+	}
+	preview, err := h.service.PreviewRollback(c.Request.Context(), adminUserID(c), request.SubscriptionID)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, preview)
+}
+
+func (h *ProxySubscriptionHandler) ApplyRollback(c *gin.Context) {
+	var request struct {
+		PlanID string `json:"plan_id" binding:"required"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil {
+		response.BadRequest(c, "Invalid request: "+err.Error())
+		return
+	}
+	result, err := h.service.ApplyRollback(c.Request.Context(), adminUserID(c), request.PlanID)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, result)
+}
+
+func subscriptionID(c *gin.Context) (int64, bool) {
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || id <= 0 {
+		response.BadRequest(c, "Invalid proxy subscription ID")
+		return 0, false
+	}
+	return id, true
+}
+
+func adminUserID(c *gin.Context) int64 {
+	if subject, ok := middleware.GetAuthSubjectFromContext(c); ok {
+		return subject.UserID
+	}
+	return 0
+}
