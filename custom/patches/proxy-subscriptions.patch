diff --git a/backend/internal/service/custom_update_service.go b/backend/internal/service/custom_update_service.go
new file mode 100644
index 00000000..5f3b88ba
--- /dev/null
+++ b/backend/internal/service/custom_update_service.go
@@ -0,0 +1,262 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const maxCustomUpdateResponseSize = 1024 * 1024
+
+var (
+	customVersionPattern = regexp.MustCompile(`^v?(\d+)\.(\d+)\.(\d+)(?:-p(\d+))?$`)
+	digestPattern        = regexp.MustCompile(`^sha256:[a-f0-9]{64}$`)
+)
+
+// CustomUpdateConfig defines the narrow, authenticated channel used by custom
+// Docker builds. The main application never receives access to Docker itself.
+type CustomUpdateConfig struct {
+	ManifestURL        string
+	UpdaterURL         string
+	UpdaterSecret      string
+	ManifestHMACSecret string
+	ImagePrefix        string
+}
+
+func (c CustomUpdateConfig) configured() bool {
+	return c.ManifestURL != "" && c.UpdaterURL != "" && c.UpdaterSecret != "" &&
+		c.ManifestHMACSecret != "" && c.ImagePrefix != ""
+}
+
+// CustomUpdateManifest is emitted only after the patch has applied cleanly,
+// all tests have passed, and the immutable image digest has been published.
+type CustomUpdateManifest struct {
+	SchemaVersion   int    `json:"schema_version"`
+	Status          string `json:"status"`
+	DisplayVersion  string `json:"display_version"`
+	UpstreamVersion string `json:"upstream_version"`
+	Image           string `json:"image"`
+	ImageDigest     string `json:"image_digest"`
+	UpstreamCommit  string `json:"upstream_commit"`
+	CustomCommit    string `json:"custom_commit"`
+	PublishedAt     string `json:"published_at"`
+	ReleaseNotes    string `json:"release_notes,omitempty"`
+	HTMLURL         string `json:"html_url,omitempty"`
+	Signature       string `json:"signature"`
+}
+
+type customManifestPayload struct {
+	SchemaVersion   int    `json:"schema_version"`
+	Status          string `json:"status"`
+	DisplayVersion  string `json:"display_version"`
+	UpstreamVersion string `json:"upstream_version"`
+	Image           string `json:"image"`
+	ImageDigest     string `json:"image_digest"`
+	UpstreamCommit  string `json:"upstream_commit"`
+	CustomCommit    string `json:"custom_commit"`
+	PublishedAt     string `json:"published_at"`
+	ReleaseNotes    string `json:"release_notes,omitempty"`
+	HTMLURL         string `json:"html_url,omitempty"`
+}
+
+func (m CustomUpdateManifest) payload() customManifestPayload {
+	return customManifestPayload{
+		SchemaVersion: m.SchemaVersion, Status: m.Status, DisplayVersion: m.DisplayVersion,
+		UpstreamVersion: m.UpstreamVersion, Image: m.Image, ImageDigest: m.ImageDigest,
+		UpstreamCommit: m.UpstreamCommit, CustomCommit: m.CustomCommit,
+		PublishedAt: m.PublishedAt, ReleaseNotes: m.ReleaseNotes, HTMLURL: m.HTMLURL,
+	}
+}
+
+func (s *UpdateService) ConfigureCustomUpdates(cfg CustomUpdateConfig) {
+	cfg.ManifestURL = strings.TrimSpace(cfg.ManifestURL)
+	cfg.UpdaterURL = strings.TrimRight(strings.TrimSpace(cfg.UpdaterURL), "/")
+	cfg.UpdaterSecret = strings.TrimSpace(cfg.UpdaterSecret)
+	cfg.ManifestHMACSecret = strings.TrimSpace(cfg.ManifestHMACSecret)
+	cfg.ImagePrefix = strings.TrimSuffix(strings.TrimSpace(cfg.ImagePrefix), ":")
+	s.customUpdate = cfg
+}
+
+func (s *UpdateService) checkCustomUpdate(ctx context.Context) (*UpdateInfo, error) {
+	info := &UpdateInfo{
+		CurrentVersion: s.currentVersion,
+		LatestVersion:  s.currentVersion,
+		BuildType:      s.buildType,
+		UpdateMode:     "custom-container",
+	}
+	if !s.customUpdate.configured() {
+		info.Warning = "custom update channel is not configured"
+		return info, nil
+	}
+
+	manifest, err := s.fetchCustomManifest(ctx)
+	if err != nil {
+		info.Warning = err.Error()
+		return info, nil
+	}
+	info.LatestVersion = manifest.DisplayVersion
+	info.HasUpdate = compareCustomVersions(s.currentVersion, manifest.DisplayVersion) < 0
+	info.ReleaseInfo = &ReleaseInfo{
+		Name:        "Sub2API " + manifest.DisplayVersion,
+		Body:        manifest.ReleaseNotes,
+		PublishedAt: manifest.PublishedAt,
+		HTMLURL:     manifest.HTMLURL,
+	}
+	return info, nil
+}
+
+func (s *UpdateService) performCustomUpdate(ctx context.Context) error {
+	if !s.customUpdate.configured() {
+		return ErrUpdatesDisabled
+	}
+	manifest, err := s.fetchCustomManifest(ctx)
+	if err != nil {
+		return err
+	}
+	if compareCustomVersions(s.currentVersion, manifest.DisplayVersion) >= 0 {
+		return ErrNoUpdateAvailable
+	}
+
+	body, err := json.Marshal(struct {
+		Image          string `json:"image"`
+		ImageDigest    string `json:"image_digest"`
+		Version        string `json:"version"`
+		CurrentVersion string `json:"current_version"`
+	}{manifest.Image, manifest.ImageDigest, manifest.DisplayVersion, s.currentVersion})
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, s.customUpdate.UpdaterURL+"/v1/update", bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("create updater request: %w", err)
+	}
+	req.Header.Set("Authorization", "Bearer "+s.customUpdate.UpdaterSecret)
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := customUpdateHTTPClient().Do(req)
+	if err != nil {
+		return fmt.Errorf("start custom update: %w", err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusAccepted && resp.StatusCode != http.StatusOK {
+		message, _ := io.ReadAll(io.LimitReader(resp.Body, 4096))
+		return fmt.Errorf("custom updater returned %d: %s", resp.StatusCode, strings.TrimSpace(string(message)))
+	}
+	return nil
+}
+
+func (s *UpdateService) fetchCustomManifest(ctx context.Context) (*CustomUpdateManifest, error) {
+	manifestURL, err := url.Parse(s.customUpdate.ManifestURL)
+	if err != nil || manifestURL.Scheme != "https" || manifestURL.Host == "" || manifestURL.User != nil {
+		return nil, fmt.Errorf("custom update manifest URL must be HTTPS")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, manifestURL.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("User-Agent", "Sub2API-Custom-Updater")
+	resp, err := customUpdateHTTPClient().Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("fetch custom update manifest: %w", err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("custom update manifest returned %d", resp.StatusCode)
+	}
+
+	var manifest CustomUpdateManifest
+	decoder := json.NewDecoder(io.LimitReader(resp.Body, maxCustomUpdateResponseSize+1))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&manifest); err != nil {
+		return nil, fmt.Errorf("decode custom update manifest: %w", err)
+	}
+	if err := s.validateCustomManifest(manifest); err != nil {
+		return nil, err
+	}
+	return &manifest, nil
+}
+
+func (s *UpdateService) validateCustomManifest(manifest CustomUpdateManifest) error {
+	if manifest.SchemaVersion != 1 || manifest.Status != "ready" {
+		return fmt.Errorf("custom update is not ready")
+	}
+	if !customVersionPattern.MatchString(manifest.DisplayVersion) ||
+		!customVersionPattern.MatchString(manifest.UpstreamVersion) {
+		return fmt.Errorf("custom update manifest has an invalid version")
+	}
+	if manifest.Image != s.customUpdate.ImagePrefix || !digestPattern.MatchString(manifest.ImageDigest) {
+		return fmt.Errorf("custom update manifest has an untrusted image")
+	}
+	if manifest.UpstreamCommit == "" || manifest.CustomCommit == "" {
+		return fmt.Errorf("custom update manifest is missing commit metadata")
+	}
+	if _, err := time.Parse(time.RFC3339, manifest.PublishedAt); err != nil {
+		return fmt.Errorf("custom update manifest has an invalid publish time")
+	}
+	payload, err := json.Marshal(manifest.payload())
+	if err != nil {
+		return err
+	}
+	want, err := hex.DecodeString(manifest.Signature)
+	if err != nil {
+		return fmt.Errorf("custom update manifest signature is invalid")
+	}
+	mac := hmac.New(sha256.New, []byte(s.customUpdate.ManifestHMACSecret))
+	_, _ = mac.Write(payload)
+	if !hmac.Equal(want, mac.Sum(nil)) {
+		return fmt.Errorf("custom update manifest signature mismatch")
+	}
+	return nil
+}
+
+func customUpdateHTTPClient() *http.Client {
+	return &http.Client{
+		Timeout: 30 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) >= 3 || req.URL.Scheme != "https" {
+				return http.ErrUseLastResponse
+			}
+			return nil
+		},
+	}
+}
+
+func compareCustomVersions(left, right string) int {
+	l := parseCustomVersion(left)
+	r := parseCustomVersion(right)
+	for i := range l {
+		if l[i] < r[i] {
+			return -1
+		}
+		if l[i] > r[i] {
+			return 1
+		}
+	}
+	return 0
+}
+
+func parseCustomVersion(version string) [4]int {
+	match := customVersionPattern.FindStringSubmatch(strings.TrimSpace(version))
+	var result [4]int
+	if match == nil {
+		base := parseVersion(version)
+		copy(result[:3], base[:])
+		return result
+	}
+	for i := 1; i < len(match); i++ {
+		if match[i] != "" {
+			result[i-1], _ = strconv.Atoi(match[i])
+		}
+	}
+	return result
+}
