@@ -0,0 +1,46 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestSetEnvValueReplacesAndAppends(t *testing.T) {
+	got := string(setEnvValue([]byte("A=1\r\nSUB2API_IMAGE=old\r\n"), "SUB2API_IMAGE", "new@sha256:abc"))
+	if strings.Count(got, "SUB2API_IMAGE=") != 1 || !strings.Contains(got, "SUB2API_IMAGE=new@sha256:abc") {
+		t.Fatalf("unexpected env: %q", got)
+	}
+	got = string(setEnvValue([]byte("A=1\n"), "SUB2API_IMAGE", "new"))
+	if !strings.Contains(got, "SUB2API_IMAGE=new") {
+		t.Fatalf("key was not appended: %q", got)
+	}
+}
+
+func TestAuthorizeUsesBearerSecret(t *testing.T) {
+	u := &updater{cfg: config{secret: "test-secret"}}
+	h := u.authorize(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNoContent) })
+	bad := httptest.NewRecorder()
+	h(bad, httptest.NewRequest(http.MethodGet, "/", nil))
+	if bad.Code != http.StatusUnauthorized {
+		t.Fatalf("got %d", bad.Code)
+	}
+	goodReq := httptest.NewRequest(http.MethodGet, "/", nil)
+	goodReq.Header.Set("Authorization", "Bearer test-secret")
+	good := httptest.NewRecorder()
+	h(good, goodReq)
+	if good.Code != http.StatusNoContent {
+		t.Fatalf("got %d", good.Code)
+	}
+}
+
+func TestStartUpdateRejectsUntrustedImage(t *testing.T) {
+	u := &updater{cfg: config{secret: "s", imagePrefix: "ghcr.io/owner/app"}, status: operationStatus{State: "idle"}}
+	req := httptest.NewRequest(http.MethodPost, "/v1/update", strings.NewReader(`{"image":"ghcr.io/other/app","image_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","version":"0.1.175-p1","current_version":"0.1.174-p1"}`))
+	w := httptest.NewRecorder()
+	u.startUpdate(w, req)
+	if w.Code != http.StatusBadRequest {
+		t.Fatalf("got %d: %s", w.Code, w.Body.String())
+	}
+}
