+func (s *ProxySubscriptionService) buildPersistedConfig(ctx context.Context, candidateSubscriptionID, candidateRevisionID int64) (map[string]any, error) {
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT n.id, n.subscription_id,
+			CASE WHEN n.subscription_id=$1 AND $2 > 0 AND n.missing_sync_count=0 THEN $2 ELSE n.revision_id END,
+			n.display_name, n.listen_port, n.inbound_username, n.inbound_password,
+			n.missing_sync_count, n.health_status
+		FROM proxy_subscription_nodes n
+		JOIN proxy_subscriptions s ON s.id=n.subscription_id
+		WHERE (s.enabled=TRUE OR EXISTS (
+			SELECT 1 FROM accounts a WHERE a.subscription_proxy_node_id=n.id AND a.subscription_proxy_mode='manual' AND a.deleted_at IS NULL
+		)) AND (n.missing_sync_count < 2 OR EXISTS (
+			SELECT 1 FROM accounts a WHERE a.subscription_proxy_node_id=n.id AND a.subscription_proxy_mode='manual' AND a.deleted_at IS NULL
+		))
+		ORDER BY n.id
+	`, candidateSubscriptionID, candidateRevisionID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	nodes := make([]managedConfigNode, 0)
+	for rows.Next() {
+		var node managedConfigNode
+		if err := rows.Scan(&node.ID, &node.SubscriptionID, &node.RevisionID, &node.DisplayName,
+			&node.ListenPort, &node.InboundUsername, &node.InboundPassword,
+			&node.MissingSyncCount, &node.HealthStatus); err != nil {
+			return nil, err
+		}
+		nodes = append(nodes, node)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	providers := make(map[string]any)
+	groups := make([]map[string]any, 0, len(nodes))
+	listeners := make([]map[string]any, 0, len(nodes))
+	for _, node := range nodes {
+		providerName := fmt.Sprintf("subscription-%d", node.RevisionID)
+		if _, exists := providers[providerName]; !exists {
+			providers[providerName] = s.providerConfig(node.RevisionID)
+		}
+		groupName := fmt.Sprintf("managed-node-%d", node.ID)
+		groups = append(groups, map[string]any{
+			"name":   groupName,
+			"type":   "select",
+			"use":    []string{providerName},
+			"filter": "^(?:" + regexp.QuoteMeta(node.DisplayName) + ")$",
+		})
+		listeners = append(listeners, map[string]any{
+			"name":   fmt.Sprintf("managed-socks-%d", node.ID),
+			"type":   "socks",
+			"listen": "0.0.0.0",
+			"port":   node.ListenPort,
+			"proxy":  groupName,
+			"users": []map[string]string{{
+				"username": node.InboundUsername,
+				"password": node.InboundPassword,
+			}},
+		})
+	}
+	config := map[string]any{
+		"mixed-port":          0,
+		"allow-lan":           true,
+		"mode":                "rule",
+		"log-level":           "warning",
+		"external-controller": "0.0.0.0:9090",
+		"secret":              s.mihomoSecret,
+		"proxy-providers":     providers,
+		"proxy-groups":        groups,
+		"listeners":           listeners,
+		"rules":               []string{"MATCH,DIRECT"},
+	}
+	return config, nil
+}
+
+func (s *ProxySubscriptionService) commitRevision(ctx context.Context, subscriptionID, revisionID int64, nodeCount int) error {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var previous sql.NullInt64
+	if err := tx.QueryRowContext(ctx, `SELECT current_revision_id FROM proxy_subscriptions WHERE id=$1 FOR UPDATE`, subscriptionID).Scan(&previous); err != nil {
+		return err
+	}
+	if previous.Valid {
+		if _, err := tx.ExecContext(ctx, `UPDATE proxy_subscription_revisions SET status='previous' WHERE id=$1`, previous.Int64); err != nil {
+			return err
+		}
+	}
+	if _, err := tx.ExecContext(ctx, `
+		UPDATE proxy_subscription_revisions SET status='active', node_count=$2, activated_at=NOW(), error_message=NULL WHERE id=$1
+	`, revisionID, nodeCount); err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `
+		UPDATE proxy_subscription_nodes SET revision_id=$2, updated_at=NOW()
+		WHERE subscription_id=$1 AND missing_sync_count=0
+	`, subscriptionID, revisionID); err != nil {
+		return err
+	}
+	_, err = tx.ExecContext(ctx, `
+		UPDATE proxy_subscriptions
+		SET previous_revision_id=current_revision_id, current_revision_id=$2,
+			last_sync_status='success', last_sync_error=NULL, consecutive_sync_failures=0,
+			last_synced_at=NOW(), next_sync_at=NOW()+make_interval(mins=>sync_interval_minutes), updated_at=NOW()
+		WHERE id=$1
+	`, subscriptionID, revisionID)
+	if err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `
+		DELETE FROM proxy_subscription_revisions r
+		WHERE r.subscription_id=$1
+		  AND r.id NOT IN ($2, COALESCE((SELECT previous_revision_id FROM proxy_subscriptions WHERE id=$1), 0))
+		  AND NOT EXISTS (SELECT 1 FROM proxy_subscription_nodes n WHERE n.revision_id=r.id)
+	`, subscriptionID, revisionID); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+func (s *ProxySubscriptionService) cleanupFailedRevision(ctx context.Context, revisionID int64) {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `
+		WITH doomed AS (
+			DELETE FROM proxy_subscription_nodes WHERE revision_id=$1 RETURNING proxy_id
+		)
+		DELETE FROM proxies WHERE id IN (SELECT proxy_id FROM doomed)
+	`, revisionID); err != nil {
+		return
+	}
+	_ = tx.Commit()
+}
+
+func (s *ProxySubscriptionService) serveRevision(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	idRaw := strings.TrimPrefix(r.URL.Path, "/internal/proxy-subscription-revisions/")
+	id, err := strconv.ParseInt(idRaw, 10, 64)
+	if err != nil {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	expires, err := strconv.ParseInt(r.URL.Query().Get("expires"), 10, 64)
+	if err != nil || expires < time.Now().Unix() || expires > time.Now().Add(proxySubscriptionRevisionURLTTL+time.Minute).Unix() {
+		http.Error(w, "expired", http.StatusForbidden)
+		return
+	}
+	provided, err := hex.DecodeString(r.URL.Query().Get("sig"))
+	if err != nil {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	mac := hmac.New(sha256.New, s.hmacSecret)
+	_, _ = mac.Write([]byte(fmt.Sprintf("%d:%d", id, expires)))
+	if !hmac.Equal(provided, mac.Sum(nil)) {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	var encrypted string
+	if err := s.db.QueryRowContext(r.Context(), `
+		SELECT encrypted_payload FROM proxy_subscription_revisions
+		WHERE id=$1 AND status IN ('candidate','active','previous')
+	`, id).Scan(&encrypted); err != nil {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	payload, err := s.encryptor.Decrypt(encrypted)
+	if err != nil {
+		http.Error(w, "decrypt failed", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "text/yaml; charset=utf-8")
+	w.Header().Set("Cache-Control", "no-store")
+	_, _ = io.WriteString(w, payload)
+}
+
+func (s *ProxySubscriptionService) syncLoop() {
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-s.stop:
+			return
+		case <-ticker.C:
+			ctx, cancel := context.WithTimeout(s.workerCtx, 90*time.Second)
+			rows, err := s.db.QueryContext(ctx, `SELECT id FROM proxy_subscriptions WHERE enabled=TRUE AND next_sync_at<=NOW() ORDER BY next_sync_at LIMIT 10`)
+			if err == nil {
+				var ids []int64
+				for rows.Next() {
+					var id int64
+					if rows.Scan(&id) == nil {
+						ids = append(ids, id)
+					}
+				}
+				rows.Close()
+				cancel()
+				for _, id := range ids {
+					s.workers.Add(1)
+					go func(subscriptionID int64) {
+						defer s.workers.Done()
+						runCtx, runCancel := context.WithTimeout(s.workerCtx, 90*time.Second)
+						defer runCancel()
+						if err := s.Sync(runCtx, subscriptionID); err != nil && !errors.Is(err, ErrProxySubscriptionBusy) {
+							slog.Warn("proxy subscription sync failed", "subscription_id", subscriptionID, "error", err)
+						}
+					}(id)
+				}
+			} else {
+				cancel()
+			}
+		}
+	}
+}
+
+func (s *ProxySubscriptionService) healthLoop() {
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-s.stop:
+			return
+		case <-ticker.C:
+			ctx, cancel := context.WithTimeout(s.workerCtx, 50*time.Second)
+			s.checkDueNodes(ctx)
+			cancel()
+		}
+	}
+}
+
+func (s *ProxySubscriptionService) checkDueNodes(ctx context.Context) {
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT n.id, n.revision_id, n.display_name
+		FROM proxy_subscription_nodes n
+		WHERE n.missing_sync_count < 2 AND (
+			n.last_checked_at IS NULL OR
+			(EXISTS (SELECT 1 FROM accounts a WHERE a.subscription_proxy_node_id=n.id AND a.deleted_at IS NULL)
+			 AND n.last_checked_at < NOW()-INTERVAL '60 seconds') OR
+			(NOT EXISTS (SELECT 1 FROM accounts a WHERE a.subscription_proxy_node_id=n.id AND a.deleted_at IS NULL)
+			 AND n.last_checked_at < NOW()-INTERVAL '10 minutes')
+		)
+		ORDER BY n.last_checked_at NULLS FIRST LIMIT 100
+	`)
+	if err != nil {
+		return
+	}
+	defer rows.Close()
+	type target struct {
+		id, revisionID int64
+		name           string
+	}
+	var targets []target
+	for rows.Next() {
+		var t target
+		if rows.Scan(&t.id, &t.revisionID, &t.name) == nil {
+			targets = append(targets, t)
+		}
+	}
+	for _, target := range targets {
+		delay, checkErr := s.checkMihomoNode(ctx, target.revisionID, target.name)
+		if checkErr != nil {
+			_, _ = s.db.ExecContext(ctx, `
+				UPDATE proxy_subscription_nodes
+				SET consecutive_failures=consecutive_failures+1, consecutive_successes=0,
+					health_status=CASE WHEN consecutive_failures+1>=3 THEN 'unhealthy' ELSE health_status END,
+					last_checked_at=NOW(), updated_at=NOW()
+				WHERE id=$1
+			`, target.id)
+			continue
+		}
+		_, _ = s.db.ExecContext(ctx, `
+			UPDATE proxy_subscription_nodes
+			SET consecutive_successes=consecutive_successes+1, consecutive_failures=0,
+				health_status=CASE WHEN consecutive_successes+1>=2 THEN 'healthy' ELSE health_status END,
+				latency_ms=$2, last_checked_at=NOW(), updated_at=NOW()
+			WHERE id=$1
+		`, target.id, delay)
+	}
+	_ = s.migrateOfflineAuto(ctx)
+	_ = s.cleanupStaleNodes(ctx)
+}
+
+func (s *ProxySubscriptionService) checkMihomoNode(ctx context.Context, revisionID int64, name string) (int, error) {
+	provider := fmt.Sprintf("subscription-%d", revisionID)
+	endpoint := fmt.Sprintf("%s/providers/proxies/%s/%s/healthcheck?url=%s&timeout=5000",
+		s.mihomoURL, url.PathEscape(provider), url.PathEscape(name), url.QueryEscape("https://www.gstatic.com/generate_204"))
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return 0, err
+	}
+	if s.mihomoSecret != "" {
+		req.Header.Set("Authorization", "Bearer "+s.mihomoSecret)
+	}
+	resp, err := s.mihomoClient.Do(req)
+	if err != nil {
+		return 0, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return 0, fmt.Errorf("health check returned %d", resp.StatusCode)
+	}
+	var result struct {
+		Delay int `json:"delay"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 4096)).Decode(&result); err != nil {
+		return 0, err
+	}
+	if result.Delay <= 0 {
+		return 0, errors.New("Mihomo reported no delay")
+	}
+	return result.Delay, nil
+}
+
+func (s *ProxySubscriptionService) cleanupStaleNodes(ctx context.Context) error {
+	_, err := s.db.ExecContext(ctx, `
+		WITH doomed AS (
+			DELETE FROM proxy_subscription_nodes n
+			WHERE n.missing_since < NOW()-INTERVAL '30 days'
+			  AND NOT EXISTS (
+				SELECT 1 FROM accounts a
+				WHERE (a.subscription_proxy_node_id=n.id OR a.proxy_id=n.proxy_id) AND a.deleted_at IS NULL
+			  )
+			RETURNING proxy_id
+		)
+		DELETE FROM proxies WHERE id IN (SELECT proxy_id FROM doomed)
+	`)
+	return err
+}
+
+func (s *ProxySubscriptionService) migrateOfflineAuto(ctx context.Context) error {
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT a.id FROM accounts a
+		JOIN proxy_subscription_nodes n ON n.id=a.subscription_proxy_node_id
+		WHERE a.deleted_at IS NULL AND a.subscription_proxy_mode='auto'
+		  AND n.health_status IN ('unhealthy','offline')
+	`)
+	if err != nil {
+		return err
+	}
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		if rows.Scan(&id) == nil {
+			ids = append(ids, id)
+		}
+	}
+	rows.Close()
+	if len(ids) == 0 {
+		return nil
+	}
+	preview, err := s.buildBalancePreview(ctx, ids)
+	if err != nil {
+		return err
+	}
+	if len(preview.Assignments) == 0 {
+		return s.clearAutoAssignments(ctx, ids)
+	}
+	return s.applyAssignments(ctx, preview.Assignments, "auto")
+}
+
+func (s *ProxySubscriptionService) clearAutoAssignments(ctx context.Context, ids []int64) error {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `
+		UPDATE accounts
+		SET proxy_id=NULL, subscription_proxy_mode=NULL, subscription_proxy_node_id=NULL,
+			subscription_previous_proxy_id=NULL, proxy_fallback_origin_id=NULL, updated_at=NOW()
+		WHERE id=ANY($1) AND deleted_at IS NULL AND subscription_proxy_mode='auto'
+	`, int64Array(ids)); err != nil {
+		return err
+	}
+	payload, _ := json.Marshal(map[string]any{"account_ids": ids})
+	if _, err := tx.ExecContext(ctx, `INSERT INTO scheduler_outbox(event_type,payload) VALUES($1,$2::jsonb)`, SchedulerOutboxEventAccountBulkChanged, payload); err != nil {
+		return err
+	}
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+	s.refreshSchedulerSnapshots(context.WithoutCancel(ctx), ids)
+	return nil
+}
