+import { apiClient } from '../client'
+import type { ProxyBalancePreview, ProxyRollbackPreview, ProxySubscription, ProxySubscriptionNode } from '@/types'
+
+export interface ProxySubscriptionInput {
+  name: string
+  url?: string
+  sync_interval_minutes: number
+  include_keywords: string[]
+  exclude_keywords: string[]
+  enabled?: boolean
+}
+
+export async function list(): Promise<ProxySubscription[]> {
+  const { data } = await apiClient.get<ProxySubscription[]>('/admin/proxy-subscriptions')
+  return data
+}
+
+export async function create(input: ProxySubscriptionInput): Promise<ProxySubscription> {
+  const { data } = await apiClient.post<ProxySubscription>('/admin/proxy-subscriptions', input)
+  return data
+}
+
+export async function update(id: number, input: ProxySubscriptionInput): Promise<ProxySubscription> {
+  const { data } = await apiClient.put<ProxySubscription>(`/admin/proxy-subscriptions/${id}`, input)
+  return data
+}
+
+export async function remove(id: number): Promise<void> {
+  await apiClient.delete(`/admin/proxy-subscriptions/${id}`)
+}
+
+export async function validate(url: string): Promise<{ reachable: boolean; content_bytes: number; payload_sha256: string }> {
+  const { data } = await apiClient.post('/admin/proxy-subscriptions/validate', { url })
+  return data
+}
+
+export async function sync(id: number): Promise<ProxySubscription> {
+  const { data } = await apiClient.post<ProxySubscription>(`/admin/proxy-subscriptions/${id}/sync`)
+  return data
+}
+
+export async function nodes(id: number): Promise<ProxySubscriptionNode[]> {
+  const { data } = await apiClient.get<ProxySubscriptionNode[]>(`/admin/proxy-subscriptions/${id}/nodes`)
+  return data
+}
+
+export async function assign(accountIds: number[], nodeId: number, filters?: Record<string, unknown>): Promise<{ updated: number }> {
+  const { data } = await apiClient.post('/admin/proxy-subscriptions/assign', { account_ids: accountIds, node_id: nodeId, filters })
+  return data
+}
+
+export async function previewBalance(accountIds: number[], filters?: Record<string, unknown>): Promise<ProxyBalancePreview> {
+  const { data } = await apiClient.post<ProxyBalancePreview>('/admin/accounts/proxy-balance/preview', { account_ids: accountIds, filters })
+  return data
+}
+
+export async function applyBalance(planId: string): Promise<ProxyBalancePreview> {
+  const { data } = await apiClient.post<ProxyBalancePreview>('/admin/accounts/proxy-balance/apply', { plan_id: planId })
+  return data
+}
+
+export async function previewRollback(subscriptionId?: number): Promise<ProxyRollbackPreview> {
+  const { data } = await apiClient.post<ProxyRollbackPreview>('/admin/proxy-subscriptions/rollback/preview', { subscription_id: subscriptionId })
+  return data
+}
+
+export async function applyRollback(planId: string): Promise<ProxyRollbackPreview> {
+  const { data } = await apiClient.post<ProxyRollbackPreview>('/admin/proxy-subscriptions/rollback/apply', { plan_id: planId })
+  return data
+}
+
+export default { list, create, update, remove, validate, sync, nodes, assign, previewBalance, applyBalance, previewRollback, applyRollback }
