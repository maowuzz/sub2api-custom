+//go:build unit
+
+package service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func signTestManifest(t *testing.T, manifest *CustomUpdateManifest, secret string) {
+	t.Helper()
+	payload, err := json.Marshal(manifest.payload())
+	require.NoError(t, err)
+	mac := hmac.New(sha256.New, []byte(secret))
+	_, _ = mac.Write(payload)
+	manifest.Signature = hex.EncodeToString(mac.Sum(nil))
+}
+
+func TestCustomManifestValidation(t *testing.T) {
+	const secret = "manifest-secret"
+	svc := NewUpdateService(nil, nil, "0.1.175-p0", "custom")
+	svc.ConfigureCustomUpdates(CustomUpdateConfig{
+		ManifestURL: "https://example.test/manifest.json", UpdaterURL: "http://updater:9091",
+		UpdaterSecret: "updater-secret", ManifestHMACSecret: secret,
+		ImagePrefix: "ghcr.io/maowuzz/sub2api-custom",
+	})
+	manifest := CustomUpdateManifest{
+		SchemaVersion: 1, Status: "ready", DisplayVersion: "0.1.175-p1",
+		UpstreamVersion: "0.1.175", Image: "ghcr.io/maowuzz/sub2api-custom",
+		ImageDigest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		UpstreamCommit: "upstream", CustomCommit: "custom", PublishedAt: time.Now().UTC().Format(time.RFC3339),
+	}
+	signTestManifest(t, &manifest, secret)
+	require.NoError(t, svc.validateCustomManifest(manifest))
+
+	manifest.Image = "ghcr.io/attacker/image"
+	require.ErrorContains(t, svc.validateCustomManifest(manifest), "untrusted image")
+	manifest.Image = "ghcr.io/maowuzz/sub2api-custom"
+	manifest.Signature = "00"
+	require.ErrorContains(t, svc.validateCustomManifest(manifest), "signature mismatch")
+}
+
+func TestCompareCustomVersionsIncludesPatchRevision(t *testing.T) {
+	require.Less(t, compareCustomVersions("0.1.175-p1", "0.1.175-p2"), 0)
+	require.Less(t, compareCustomVersions("0.1.175-proxy-subscriptions.1", "0.1.175-p1"), 0)
+	require.Greater(t, compareCustomVersions("0.1.176-p1", "0.1.175-p9"), 0)
+}
