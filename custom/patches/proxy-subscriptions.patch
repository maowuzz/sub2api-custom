diff --git a/deploy/updater/main.go b/deploy/updater/main.go
new file mode 100644
index 00000000..5d370bd0
--- /dev/null
+++ b/deploy/updater/main.go
@@ -0,0 +1,329 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+const maxRequestBytes = 64 * 1024
+
+var (
+	digestPattern  = regexp.MustCompile(`^sha256:[a-f0-9]{64}$`)
+	versionPattern = regexp.MustCompile(`^\d+\.\d+\.\d+-p\d+$`)
+)
+
+type config struct {
+	listenAddr  string
+	secret      string
+	imagePrefix string
+	workspace   string
+	backupRoot  string
+	projectName string
+}
+
+type updateRequest struct {
+	Image          string `json:"image"`
+	ImageDigest    string `json:"image_digest"`
+	Version        string `json:"version"`
+	CurrentVersion string `json:"current_version"`
+}
+
+type operationStatus struct {
+	State       string `json:"state"`
+	Version     string `json:"version,omitempty"`
+	StartedAt   string `json:"started_at,omitempty"`
+	CompletedAt string `json:"completed_at,omitempty"`
+	Error       string `json:"error,omitempty"`
+}
+
+type updater struct {
+	cfg    config
+	mu     sync.Mutex
+	status operationStatus
+}
+
+func main() {
+	cfg := config{
+		listenAddr:  getenv("UPDATER_LISTEN_ADDR", ":9091"),
+		secret:      strings.TrimSpace(os.Getenv("UPDATER_SECRET")),
+		imagePrefix: strings.TrimSpace(os.Getenv("UPDATER_IMAGE_PREFIX")),
+		workspace:   filepath.Clean(getenv("UPDATER_WORKSPACE", "/workspace")),
+		backupRoot:  filepath.Clean(getenv("UPDATER_BACKUP_ROOT", "/workspace/backups/automatic")),
+		projectName: getenv("COMPOSE_PROJECT_NAME", "sub2api"),
+	}
+	if cfg.secret == "" || cfg.imagePrefix == "" || cfg.workspace == "/" || cfg.backupRoot == "/" {
+		log.Fatal("UPDATER_SECRET, UPDATER_IMAGE_PREFIX and scoped workspace paths are required")
+	}
+	u := &updater{cfg: cfg, status: operationStatus{State: "idle"}}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /health", u.health)
+	mux.HandleFunc("GET /v1/status", u.authorize(u.getStatus))
+	mux.HandleFunc("POST /v1/update", u.authorize(u.startUpdate))
+	server := &http.Server{Addr: cfg.listenAddr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	log.Printf("sub2api updater listening on %s", cfg.listenAddr)
+	log.Fatal(server.ListenAndServe())
+}
+
+func (u *updater) health(w http.ResponseWriter, _ *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
+}
+
+func (u *updater) authorize(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		got := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		if len(got) != len(u.cfg.secret) || subtle.ConstantTimeCompare([]byte(got), []byte(u.cfg.secret)) != 1 {
+			writeJSON(w, http.StatusUnauthorized, map[string]string{"error": "unauthorized"})
+			return
+		}
+		next(w, r)
+	}
+}
+
+func (u *updater) getStatus(w http.ResponseWriter, _ *http.Request) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	writeJSON(w, http.StatusOK, u.status)
+}
+
+func (u *updater) startUpdate(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	decoder := json.NewDecoder(io.LimitReader(r.Body, maxRequestBytes+1))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&req); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid request"})
+		return
+	}
+	if req.Image != u.cfg.imagePrefix || !digestPattern.MatchString(req.ImageDigest) ||
+		!versionPattern.MatchString(req.Version) || req.CurrentVersion == "" {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "untrusted update target"})
+		return
+	}
+
+	u.mu.Lock()
+	if u.status.State == "running" {
+		u.mu.Unlock()
+		writeJSON(w, http.StatusConflict, map[string]string{"error": "update already running"})
+		return
+	}
+	u.status = operationStatus{State: "running", Version: req.Version, StartedAt: time.Now().UTC().Format(time.RFC3339)}
+	u.persistStatusLocked()
+	u.mu.Unlock()
+
+	go u.run(req)
+	writeJSON(w, http.StatusAccepted, map[string]string{"status": "accepted", "version": req.Version})
+}
+
+func (u *updater) run(req updateRequest) {
+	err := u.deploy(req)
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.status.CompletedAt = time.Now().UTC().Format(time.RFC3339)
+	if err != nil {
+		u.status.State = "failed"
+		u.status.Error = err.Error()
+		log.Printf("update to %s failed: %v", req.Version, err)
+	} else {
+		u.status.State = "succeeded"
+		log.Printf("update to %s succeeded", req.Version)
+	}
+	u.persistStatusLocked()
+}
+
+func (u *updater) deploy(req updateRequest) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Minute)
+	defer cancel()
+	backupDir := filepath.Join(u.cfg.backupRoot, time.Now().UTC().Format("20060102-150405")+"-"+req.Version)
+	if err := os.MkdirAll(backupDir, 0700); err != nil {
+		return fmt.Errorf("create backup: %w", err)
+	}
+
+	oldImage, err := u.commandOutput(ctx, "docker", "inspect", "--format", "{{.Config.Image}}", "sub2api")
+	if err != nil || strings.TrimSpace(oldImage) == "" {
+		return fmt.Errorf("inspect current image: %w", err)
+	}
+	oldImage = strings.TrimSpace(oldImage)
+	oldEnv, err := os.ReadFile(filepath.Join(u.cfg.workspace, ".env"))
+	if err != nil {
+		return fmt.Errorf("read .env: %w", err)
+	}
+	if err := u.backupFiles(backupDir); err != nil {
+		return err
+	}
+	beforeMapping, err := u.accountMapping(ctx)
+	if err != nil {
+		return fmt.Errorf("snapshot account mapping: %w", err)
+	}
+	if err := os.WriteFile(filepath.Join(backupDir, "account-proxy-mapping.csv"), beforeMapping, 0600); err != nil {
+		return err
+	}
+	if err := u.pgDump(ctx, filepath.Join(backupDir, "database.dump")); err != nil {
+		return fmt.Errorf("database backup: %w", err)
+	}
+
+	target := req.Image + "@" + req.ImageDigest
+	if _, err := u.commandOutput(ctx, "docker", "pull", target); err != nil {
+		return fmt.Errorf("pull target image: %w", err)
+	}
+	newEnv := setEnvValue(oldEnv, "SUB2API_IMAGE", target)
+	if err := atomicWrite(filepath.Join(u.cfg.workspace, ".env"), newEnv, 0600); err != nil {
+		return fmt.Errorf("update .env: %w", err)
+	}
+
+	rollback := func(cause error) error {
+		_ = atomicWrite(filepath.Join(u.cfg.workspace, ".env"), setEnvValue(oldEnv, "SUB2API_IMAGE", oldImage), 0600)
+		rollbackCtx, rollbackCancel := context.WithTimeout(context.Background(), 5*time.Minute)
+		defer rollbackCancel()
+		_, rollbackErr := u.compose(rollbackCtx, "up", "-d", "--no-deps", "--force-recreate", "sub2api")
+		if rollbackErr != nil {
+			return fmt.Errorf("%v; rollback to %s failed: %w", cause, oldImage, rollbackErr)
+		}
+		return fmt.Errorf("%v; restored %s", cause, oldImage)
+	}
+
+	if _, err := u.compose(ctx, "up", "-d", "--no-deps", "--force-recreate", "sub2api"); err != nil {
+		return rollback(fmt.Errorf("deploy target: %w", err))
+	}
+	if err := u.waitHealthy(ctx, target); err != nil {
+		return rollback(err)
+	}
+	afterMapping, err := u.accountMapping(ctx)
+	if err != nil {
+		return rollback(fmt.Errorf("verify account mapping: %w", err))
+	}
+	if sha256.Sum256(beforeMapping) != sha256.Sum256(afterMapping) {
+		return rollback(errors.New("account/proxy mapping changed during update"))
+	}
+	return nil
+}
+
+func (u *updater) backupFiles(backupDir string) error {
+	for _, name := range []string{".env", "docker-compose.yml", "docker-compose.override.yml", "Caddyfile"} {
+		src := filepath.Join(u.cfg.workspace, name)
+		data, err := os.ReadFile(src)
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("backup %s: %w", name, err)
+		}
+		if err := os.WriteFile(filepath.Join(backupDir, name), data, 0600); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (u *updater) pgDump(ctx context.Context, dest string) error {
+	cmd := exec.CommandContext(ctx, "docker", "exec", "sub2api-postgres", "sh", "-c", `PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc`)
+	out, err := os.OpenFile(dest, os.O_CREATE|os.O_WRONLY|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	cmd.Stdout = out
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("%w: %s", err, stderr.String())
+	}
+	return out.Sync()
+}
+
+func (u *updater) accountMapping(ctx context.Context) ([]byte, error) {
+	query := `COPY (SELECT id, COALESCE(proxy_id,0), COALESCE(subscription_proxy_mode,''), COALESCE(subscription_proxy_node_id,0), COALESCE(subscription_previous_proxy_id,0) FROM accounts ORDER BY id) TO STDOUT WITH CSV`
+	return u.commandBytes(ctx, "docker", "exec", "sub2api-postgres", "sh", "-c", `PGPASSWORD="$POSTGRES_PASSWORD" psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "`+query+`"`)
+}
+
+func (u *updater) waitHealthy(ctx context.Context, target string) error {
+	deadline := time.Now().Add(4 * time.Minute)
+	for time.Now().Before(deadline) {
+		image, _ := u.commandOutput(ctx, "docker", "inspect", "--format", "{{.Config.Image}}", "sub2api")
+		health, _ := u.commandOutput(ctx, "docker", "inspect", "--format", "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}", "sub2api")
+		if strings.TrimSpace(image) == target && strings.TrimSpace(health) == "healthy" {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(3 * time.Second):
+		}
+	}
+	logs, _ := u.commandOutput(ctx, "docker", "logs", "--tail", "80", "sub2api")
+	return fmt.Errorf("new container did not become healthy: %s", logs)
+}
+
+func (u *updater) compose(ctx context.Context, args ...string) (string, error) {
+	base := []string{"compose", "--project-name", u.cfg.projectName, "--project-directory", u.cfg.workspace}
+	return u.commandOutput(ctx, "docker", append(base, args...)...)
+}
+
+func (u *updater) commandOutput(ctx context.Context, name string, args ...string) (string, error) {
+	data, err := u.commandBytes(ctx, name, args...)
+	return string(data), err
+}
+
+func (u *updater) commandBytes(ctx context.Context, name string, args ...string) ([]byte, error) {
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.Dir = u.cfg.workspace
+	data, err := cmd.CombinedOutput()
+	if err != nil {
+		return data, fmt.Errorf("%s %s: %w: %s", name, strings.Join(args, " "), err, strings.TrimSpace(string(data)))
+	}
+	return data, nil
+}
+
+func (u *updater) persistStatusLocked() {
+	data, _ := json.MarshalIndent(u.status, "", "  ")
+	_ = os.MkdirAll(filepath.Join(u.cfg.workspace, ".updater"), 0700)
+	_ = atomicWrite(filepath.Join(u.cfg.workspace, ".updater", "status.json"), append(data, '\n'), 0600)
+}
+
+func setEnvValue(data []byte, key, value string) []byte {
+	lines := strings.Split(strings.ReplaceAll(string(data), "\r\n", "\n"), "\n")
+	found := false
+	for i, line := range lines {
+		if strings.HasPrefix(line, key+"=") {
+			lines[i] = key + "=" + value
+			found = true
+		}
+	}
+	if !found {
+		lines = append(lines, key+"="+value)
+	}
+	return []byte(strings.Join(lines, "\n"))
+}
+
+func atomicWrite(path string, data []byte, mode os.FileMode) error {
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, mode); err != nil {
+		return err
+	}
+	return os.Rename(tmp, path)
+}
+
+func writeJSON(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+func getenv(key, fallback string) string {
+	if value := strings.TrimSpace(os.Getenv(key)); value != "" {
+		return value
+	}
+	return fallback
+}
