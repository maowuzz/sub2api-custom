+func (s *ProxySubscriptionService) Sync(ctx context.Context, id int64) error {
+	if len(s.hmacSecret) < 32 {
+		return errors.New("PROXY_SUBSCRIPTION_HMAC_SECRET must contain at least 32 characters")
+	}
+	lockKey := fmt.Sprintf("proxy-subscription:sync:%d", id)
+	lockValue, err := proxySubscriptionRandomHex(16)
+	if err != nil {
+		return err
+	}
+	locked, err := s.redis.SetNX(ctx, lockKey, lockValue, 2*time.Minute).Result()
+	if err != nil {
+		return err
+	}
+	if !locked {
+		return ErrProxySubscriptionBusy
+	}
+	defer func() {
+		if current, getErr := s.redis.Get(context.Background(), lockKey).Result(); getErr == nil && current == lockValue {
+			_ = s.redis.Del(context.Background(), lockKey).Err()
+		}
+	}()
+
+	sub, encryptedURL, err := s.getWithEncryptedURL(ctx, id)
+	if err != nil {
+		return err
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE proxy_subscriptions SET last_sync_status='syncing', last_sync_error=NULL, updated_at=NOW() WHERE id=$1`, id); err != nil {
+		return err
+	}
+	rawURL, err := s.encryptor.Decrypt(encryptedURL)
+	if err != nil {
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	etag, modified := s.currentRevisionHeaders(ctx, sub.CurrentRevisionID)
+	payload, etag, modified, err := s.fetch(ctx, rawURL, etag, modified)
+	if errors.Is(err, sql.ErrNoRows) {
+		_, updateErr := s.db.ExecContext(ctx, `
+			UPDATE proxy_subscriptions SET last_sync_status='success', last_sync_error=NULL,
+				consecutive_sync_failures=0,
+				last_synced_at=NOW(), next_sync_at=NOW() + make_interval(mins => sync_interval_minutes), updated_at=NOW()
+			WHERE id=$1
+		`, id)
+		if updateErr != nil {
+			return updateErr
+		}
+		if reloadErr := s.reloadPersistedConfigWithTimeout(); reloadErr != nil {
+			return s.recordSyncFailure(ctx, id, reloadErr)
+		}
+		return nil
+	}
+	if err != nil {
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	encryptedPayload, err := s.encryptor.Encrypt(string(payload))
+	if err != nil {
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	sum := sha256.Sum256(payload)
+	var revisionID int64
+	if err := s.db.QueryRowContext(ctx, `
+		INSERT INTO proxy_subscription_revisions
+			(subscription_id, encrypted_payload, payload_sha256, etag, last_modified, status)
+		VALUES ($1, $2, $3, NULLIF($4,''), NULLIF($5,''), 'candidate') RETURNING id
+	`, id, encryptedPayload, hex.EncodeToString(sum[:]), etag, modified).Scan(&revisionID); err != nil {
+		return s.recordSyncFailure(ctx, id, err)
+	}
+
+	providerName := fmt.Sprintf("candidate-%d-%d", id, revisionID)
+	discoveryConfig, err := s.discoveryConfig(ctx, providerName, revisionID)
+	if err != nil {
+		s.markRevisionFailed(ctx, revisionID, err)
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	providerNodes, err := s.discoverProviderNodes(ctx, discoveryConfig, providerName)
+	if err != nil {
+		s.markRevisionFailed(ctx, revisionID, err)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	filtered := filterProviderNodes(providerNodes, sub.IncludeKeywords, append(defaultProxySubscriptionExcludes, sub.ExcludeKeywords...))
+	if len(filtered) == 0 {
+		err = errors.New("subscription contains no nodes after filtering")
+		s.markRevisionFailed(ctx, revisionID, err)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	if len(filtered) > proxySubscriptionMaxPerSource {
+		err = fmt.Errorf("subscription has %d nodes after filtering; limit is %d", len(filtered), proxySubscriptionMaxPerSource)
+		s.markRevisionFailed(ctx, revisionID, err)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	if err := s.stageNodes(ctx, id, revisionID, filtered); err != nil {
+		s.markRevisionFailed(ctx, revisionID, err)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	if err := s.reloadCandidateConfig(ctx, id, revisionID); err != nil {
+		s.cleanupFailedRevision(context.Background(), revisionID)
+		s.markRevisionFailed(ctx, revisionID, err)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	if err := s.commitRevision(ctx, id, revisionID, len(filtered)); err != nil {
+		s.cleanupFailedRevision(context.Background(), revisionID)
+		_ = s.reloadPersistedConfigWithTimeout()
+		return s.recordSyncFailure(ctx, id, err)
+	}
+	if err := s.migrateOfflineAuto(ctx); err != nil {
+		slog.Warn("proxy subscription auto migration failed", "subscription_id", id, "error", err)
+	}
+	return nil
+}
+
+func (s *ProxySubscriptionService) currentRevisionHeaders(ctx context.Context, revisionID *int64) (string, string) {
+	if revisionID == nil {
+		return "", ""
+	}
+	var etag, modified sql.NullString
+	if err := s.db.QueryRowContext(ctx, `SELECT etag, last_modified FROM proxy_subscription_revisions WHERE id=$1`, *revisionID).Scan(&etag, &modified); err != nil {
+		return "", ""
+	}
+	return etag.String, modified.String
+}
+
+func (s *ProxySubscriptionService) recordSyncFailure(ctx context.Context, id int64, syncErr error) error {
+	_, _ = s.db.ExecContext(ctx, `
+		UPDATE proxy_subscriptions
+		SET last_sync_status=CASE WHEN current_revision_id IS NULL THEN 'error' ELSE 'degraded' END,
+			last_sync_error=$2, consecutive_sync_failures=consecutive_sync_failures+1,
+			next_sync_at=NOW() + LEAST(INTERVAL '1 hour', (INTERVAL '5 minutes' * (consecutive_sync_failures + 1))),
+			updated_at=NOW()
+		WHERE id=$1
+	`, id, redactSubscriptionError(syncErr))
+	return syncErr
+}
+
+func truncateError(err error) string {
+	if err == nil {
+		return ""
+	}
+	value := err.Error()
+	if len(value) > 2000 {
+		return value[:2000]
+	}
+	return value
+}
+
+func (s *ProxySubscriptionService) markRevisionFailed(ctx context.Context, revisionID int64, err error) {
+	_, _ = s.db.ExecContext(ctx, `UPDATE proxy_subscription_revisions SET status='failed', error_message=$2 WHERE id=$1`, revisionID, redactSubscriptionError(err))
+}
+
+func filterProviderNodes(nodes []mihomoProviderProxy, includes, excludes []string) []mihomoProviderProxy {
+	result := make([]mihomoProviderProxy, 0, len(nodes))
+	seen := make(map[string]struct{}, len(nodes))
+	for _, node := range nodes {
+		name := strings.TrimSpace(node.Name)
+		lower := strings.ToLower(name)
+		if name == "" || matchesAny(lower, excludes) {
+			continue
+		}
+		if len(includes) > 0 && !matchesAny(lower, includes) {
+			continue
+		}
+		key := strings.ToLower(node.Type) + "\x00" + lower
+		if _, exists := seen[key]; exists {
+			continue
+		}
+		seen[key] = struct{}{}
+		result = append(result, node)
+	}
+	sort.SliceStable(result, func(i, j int) bool { return strings.ToLower(result[i].Name) < strings.ToLower(result[j].Name) })
+	return result
+}
+
+func matchesAny(lowerName string, keywords []string) bool {
+	for _, keyword := range keywords {
+		if keyword = strings.ToLower(strings.TrimSpace(keyword)); keyword != "" && strings.Contains(lowerName, keyword) {
+			return true
+		}
+	}
+	return false
+}
