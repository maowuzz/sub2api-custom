+}
+
+type ProxySubscriptionService struct {
+	db             *sql.DB
+	redis          *redis.Client
+	encryptor      SecretEncryptor
+	accountRepo    AdminAccountRepository
+	schedulerCache SchedulerCache
+	mihomoURL      string
+	mihomoSecret   string
+	hmacSecret     []byte
+	internalBase   string
+	internalAddr   string
+	client         *http.Client
+	mihomoClient   *http.Client
+	server         *http.Server
+	stop           chan struct{}
+	stopOnce       sync.Once
+	workers        sync.WaitGroup
+	mihomoMu       sync.Mutex
+	workerCtx      context.Context
+	workerCancel   context.CancelFunc
+}
+
+func NewProxySubscriptionService(
+	db *sql.DB,
+	redisClient *redis.Client,
+	encryptor SecretEncryptor,
+	accountRepo AdminAccountRepository,
+	schedulerCache SchedulerCache,
+) *ProxySubscriptionService {
+	workerCtx, workerCancel := context.WithCancel(context.Background())
+	s := &ProxySubscriptionService{
+		db:             db,
+		redis:          redisClient,
+		encryptor:      encryptor,
+		accountRepo:    accountRepo,
+		schedulerCache: schedulerCache,
+		mihomoURL:      strings.TrimRight(envOr("MIHOMO_CONTROLLER_URL", "http://mihomo:9090"), "/"),
+		mihomoSecret:   os.Getenv("MIHOMO_CONTROLLER_SECRET"),
+		hmacSecret:     []byte(os.Getenv("PROXY_SUBSCRIPTION_HMAC_SECRET")),
+		internalBase:   strings.TrimRight(envOr("PROXY_SUBSCRIPTION_INTERNAL_BASE_URL", "http://sub2api:8081"), "/"),
+		internalAddr:   envOr("PROXY_SUBSCRIPTION_INTERNAL_ADDR", ":8081"),
+		stop:           make(chan struct{}),
+		workerCtx:      workerCtx,
+		workerCancel:   workerCancel,
+	}
+	s.client = newSecureSubscriptionHTTPClient()
+	s.mihomoClient = &http.Client{Timeout: 15 * time.Second}
+	s.start()
+	return s
+}
+
+func envOr(key, fallback string) string {
+	if value := strings.TrimSpace(os.Getenv(key)); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func (s *ProxySubscriptionService) start() {
+	if s == nil || s.db == nil || s.encryptor == nil {
+		return
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/internal/proxy-subscription-revisions/", s.serveRevision)
+	s.server = &http.Server{Addr: s.internalAddr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	go func() {
+		if err := s.server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
+			slog.Error("proxy subscription snapshot server stopped", "error", err)
+		}
+	}()
+	s.workers.Add(3)
+	go func() { defer s.workers.Done(); s.restorePersistedConfigLoop() }()
+	go func() { defer s.workers.Done(); s.syncLoop() }()
+	go func() { defer s.workers.Done(); s.healthLoop() }()
+}
+
+func (s *ProxySubscriptionService) restorePersistedConfigLoop() {
+	for attempt := 0; ; attempt++ {
+		delay := time.Duration(attempt+1) * time.Second
+		if delay > 30*time.Second {
+			delay = 30 * time.Second
+		}
+		select {
+		case <-s.stop:
+			return
+		case <-time.After(delay):
+		}
+		ctx, cancel := context.WithTimeout(s.workerCtx, 15*time.Second)
+		err := s.reloadPersistedConfig(ctx)
+		cancel()
+		if err == nil {
+			return
+		}
+		slog.Warn("proxy subscription persisted config restore failed", "attempt", attempt+1, "error", redactSubscriptionError(err))
+	}
+}
+
+func (s *ProxySubscriptionService) Stop(ctx context.Context) error {
+	if s == nil {
+		return nil
+	}
+	s.stopOnce.Do(func() { close(s.stop) })
+	if s.workerCancel != nil {
+		s.workerCancel()
+	}
+	waitDone := make(chan struct{})
+	go func() { s.workers.Wait(); close(waitDone) }()
+	if s.server != nil {
+		if err := s.server.Shutdown(ctx); err != nil {
+			return err
+		}
+	}
+	select {
+	case <-waitDone:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func newSecureSubscriptionHTTPClient() *http.Client {
+	transport := &http.Transport{
+		Proxy:               nil,
+		DisableCompression:  true,
+		ForceAttemptHTTP2:   true,
+		TLSHandshakeTimeout: 10 * time.Second,
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			host, port, err := net.SplitHostPort(address)
+			if err != nil {
+				return nil, err
+			}
+			ips, err := net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+			if err != nil {
+				return nil, err
+			}
+			for _, ip := range ips {
+				if !isPublicSubscriptionIP(net.IP(ip.AsSlice())) {
+					continue
+				}
+				return (&net.Dialer{Timeout: 10 * time.Second}).DialContext(ctx, network, net.JoinHostPort(ip.String(), port))
+			}
+			return nil, fmt.Errorf("subscription host %q has no public address", host)
+		},
+	}
+	return &http.Client{
+		Transport: transport,
+		Timeout:   30 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) >= 5 {
+				return errors.New("too many redirects")
+			}
+			return validateSubscriptionURL(req.URL)
+		},
+	}
+}
+
+func isPublicSubscriptionIP(ip net.IP) bool {
+	if ip == nil {
+		return false
+	}
+	addr, ok := netip.AddrFromSlice(ip)
+	if !ok || !addr.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsUnspecified() ||
+		ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast() || ip.IsMulticast() {
+		return false
+	}
+	addr = addr.Unmap()
+	for _, prefix := range subscriptionSpecialUsePrefixes {
+		if prefix.Contains(addr) {
+			return false
+		}
+	}
+	return true
+}
+
+func validateSubscriptionURL(u *url.URL) error {
+	if u == nil || (u.Scheme != "http" && u.Scheme != "https") || u.Hostname() == "" {
+		return fmt.Errorf("only public HTTP/HTTPS subscription URLs are accepted")
+	}
+	if u.User != nil {
+		return errors.New("userinfo is not allowed in subscription URLs")
+	}
+	if ip := net.ParseIP(u.Hostname()); ip != nil && !isPublicSubscriptionIP(ip) {
+		return errors.New("private and special-use subscription addresses are blocked")
+	}
+	return nil
+}
+
+func maskSubscriptionURL(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return "***"
+	}
+	u.RawQuery = ""
+	u.Fragment = ""
+	if path := strings.Trim(u.Path, "/"); path != "" {
+		parts := strings.Split(path, "/")
+		parts[len(parts)-1] = "***"
+		u.Path = "/" + strings.Join(parts, "/")
+	}
+	return strings.ReplaceAll(strings.ReplaceAll(u.String(), "%2A%2A%2A", "***"), "%2a%2a%2a", "***")
+}
+
+var subscriptionSpecialUsePrefixes = []netip.Prefix{
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("192.0.0.0/24"),
+	netip.MustParsePrefix("192.0.2.0/24"),
+	netip.MustParsePrefix("198.18.0.0/15"),
+	netip.MustParsePrefix("198.51.100.0/24"),
+	netip.MustParsePrefix("203.0.113.0/24"),
+	netip.MustParsePrefix("2001:db8::/32"),
+}
+
+func redactSubscriptionError(err error) string {
+	if err == nil {
+		return ""
+	}
+	message := regexp.MustCompile(`https?://[^\s"'<>]+`).ReplaceAllStringFunc(err.Error(), maskSubscriptionURL)
+	return truncateError(errors.New(message))
+}
+
+func normalizeSubscriptionInput(input ProxySubscriptionInput) (ProxySubscriptionInput, error) {
+	input.Name = strings.TrimSpace(input.Name)
+	input.URL = strings.TrimSpace(input.URL)
+	if input.Name == "" || len(input.Name) > 100 {
+		return input, errors.New("name is required and must be at most 100 characters")
+	}
+	if input.SyncIntervalMinutes == 0 {
+		input.SyncIntervalMinutes = 360
+	}
+	if input.SyncIntervalMinutes < 15 || input.SyncIntervalMinutes > 10080 {
+		return input, errors.New("sync interval must be between 15 and 10080 minutes")
+	}
+	if input.URL != "" {
+		u, err := url.Parse(input.URL)
+		if err != nil {
+			return input, err
+		}
+		if err := validateSubscriptionURL(u); err != nil {
+			return input, err
+		}
+	}
+	input.IncludeKeywords = normalizeKeywords(input.IncludeKeywords)
+	input.ExcludeKeywords = normalizeKeywords(input.ExcludeKeywords)
+	return input, nil
+}
+
+func normalizeKeywords(values []string) []string {
+	seen := make(map[string]struct{}, len(values))
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		value = strings.TrimSpace(value)
+		key := strings.ToLower(value)
+		if value == "" {
+			continue
+		}
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, value)
+	}
+	return out
+}
+
+func (s *ProxySubscriptionService) fetch(ctx context.Context, rawURL, etag, modified string) ([]byte, string, string, error) {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return nil, "", "", err
+	}
+	if err := validateSubscriptionURL(u); err != nil {
+		return nil, "", "", err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return nil, "", "", err
+	}
+	req.Header.Set("User-Agent", "clash.meta")
+	req.Header.Set("Accept", "text/yaml,text/plain,application/octet-stream;q=0.9,*/*;q=0.1")
+	if etag != "" {
+		req.Header.Set("If-None-Match", etag)
+	}
+	if modified != "" {
+		req.Header.Set("If-Modified-Since", modified)
+	}
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return nil, "", "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusNotModified {
+		return nil, etag, modified, sql.ErrNoRows
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, "", "", fmt.Errorf("subscription returned HTTP %d", resp.StatusCode)
+	}
+	limited := io.LimitReader(resp.Body, proxySubscriptionMaxBody+1)
+	payload, err := io.ReadAll(limited)
+	if err != nil {
+		return nil, "", "", err
+	}
+	if len(payload) == 0 || len(payload) > proxySubscriptionMaxBody {
+		return nil, "", "", errors.New("subscription payload is empty or exceeds 10 MiB")
+	}
+	return payload, resp.Header.Get("ETag"), resp.Header.Get("Last-Modified"), nil
+}
+
+func (s *ProxySubscriptionService) Validate(ctx context.Context, rawURL string) (*ProxySubscriptionValidation, error) {
+	payload, etag, modified, err := s.fetch(ctx, strings.TrimSpace(rawURL), "", "")
+	if err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256(payload)
+	return &ProxySubscriptionValidation{Reachable: true, ContentBytes: len(payload), PayloadSHA256: hex.EncodeToString(sum[:]), ETag: etag, LastModified: modified}, nil
+}
+
+func (s *ProxySubscriptionService) Create(ctx context.Context, input ProxySubscriptionInput) (*ProxySubscription, error) {
+	input, err := normalizeSubscriptionInput(input)
+	if err != nil || input.URL == "" {
+		if err == nil {
+			err = errors.New("subscription URL is required")
+		}
+		return nil, fmt.Errorf("%w: %v", ErrProxySubscriptionInvalid, err)
+	}
+	encryptedURL, err := s.encryptor.Encrypt(input.URL)
+	if err != nil {
+		return nil, err
+	}
+	enabled := true
+	if input.Enabled != nil {
+		enabled = *input.Enabled
+	}
+	var id int64
+	err = s.db.QueryRowContext(ctx, `
+		INSERT INTO proxy_subscriptions
+			(name, encrypted_url, sync_interval_minutes, include_keywords, exclude_keywords, enabled, next_sync_at)
+		VALUES ($1, $2, $3, $4, $5, $6, NOW())
+		RETURNING id
+	`, input.Name, encryptedURL, input.SyncIntervalMinutes, stringArray(input.IncludeKeywords), stringArray(input.ExcludeKeywords), enabled).Scan(&id)
+	if err != nil {
+		return nil, err
+	}
+	return s.Get(ctx, id)
+}
+
+func (s *ProxySubscriptionService) Update(ctx context.Context, id int64, input ProxySubscriptionInput) (*ProxySubscription, error) {
+	input, err := normalizeSubscriptionInput(input)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrProxySubscriptionInvalid, err)
+	}
+	current, encryptedURL, err := s.getWithEncryptedURL(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if input.URL != "" {
+		encryptedURL, err = s.encryptor.Encrypt(input.URL)
+		if err != nil {
+			return nil, err
+		}
+	}
+	enabled := current.Enabled
+	if input.Enabled != nil {
+		enabled = *input.Enabled
+	}
+	result, err := s.db.ExecContext(ctx, `
+		UPDATE proxy_subscriptions
+		SET name = $2, encrypted_url = $3, sync_interval_minutes = $4,
+			include_keywords = $5, exclude_keywords = $6, enabled = $7,
+			next_sync_at = CASE WHEN $7 THEN LEAST(next_sync_at, NOW()) ELSE next_sync_at END,
+			updated_at = NOW()
+		WHERE id = $1
+	`, id, input.Name, encryptedURL, input.SyncIntervalMinutes, stringArray(input.IncludeKeywords), stringArray(input.ExcludeKeywords), enabled)
+	if err != nil {
+		return nil, err
+	}
+	if n, _ := result.RowsAffected(); n == 0 {
+		return nil, ErrProxySubscriptionNotFound
+	}
+	if !enabled {
+		_, _ = s.db.ExecContext(ctx, `UPDATE proxy_subscription_nodes SET health_status='offline', updated_at=NOW() WHERE subscription_id=$1`, id)
+		if err := s.migrateOfflineAuto(ctx); err != nil {
+			slog.Warn("proxy subscription auto migration after disable failed", "subscription_id", id, "error", err)
+		}
+	}
+	updated, err := s.Get(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.reloadPersistedConfigWithTimeout(); err != nil {
+		slog.Warn("proxy subscription config refresh after update failed", "subscription_id", id, "error", redactSubscriptionError(err))
+	}
+	return updated, nil
+}
+
+func (s *ProxySubscriptionService) Delete(ctx context.Context, id int64) error {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var assigned int
+	if err := tx.QueryRowContext(ctx, `
+		SELECT COUNT(DISTINCT a.id) FROM accounts a
+		JOIN proxy_subscription_nodes n ON n.subscription_id = $1
+		WHERE a.deleted_at IS NULL AND (a.subscription_proxy_node_id = n.id OR a.proxy_id = n.proxy_id)
+	`, id).Scan(&assigned); err != nil {
+		return err
+	}
+	if assigned > 0 {
+		return infraerrors.Conflict("PROXY_SUBSCRIPTION_IN_USE", "subscription still has assigned accounts")
+	}
+	if _, err := tx.ExecContext(ctx, `
+		WITH doomed AS (
+			DELETE FROM proxy_subscription_nodes WHERE subscription_id=$1 RETURNING proxy_id
+		)
+		DELETE FROM proxies WHERE id IN (SELECT proxy_id FROM doomed)
+	`, id); err != nil {
+		return err
+	}
+	result, err := tx.ExecContext(ctx, "DELETE FROM proxy_subscriptions WHERE id = $1", id)
+	if err != nil {
+		return err
+	}
+	if n, _ := result.RowsAffected(); n == 0 {
+		return ErrProxySubscriptionNotFound
+	}
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+	return s.reloadPersistedConfigWithTimeout()
+}
+
+func (s *ProxySubscriptionService) reloadPersistedConfigWithTimeout() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	return s.reloadPersistedConfig(ctx)
+}
+
+func (s *ProxySubscriptionService) Get(ctx context.Context, id int64) (*ProxySubscription, error) {
+	sub, _, err := s.getWithEncryptedURL(ctx, id)
+	return sub, err
+}
+
+func (s *ProxySubscriptionService) getWithEncryptedURL(ctx context.Context, id int64) (*ProxySubscription, string, error) {
+	row := s.db.QueryRowContext(ctx, `
+		SELECT s.id, s.name, s.encrypted_url, s.sync_interval_minutes,
+			s.include_keywords, s.exclude_keywords, s.enabled,
+			s.current_revision_id, s.previous_revision_id, s.last_sync_status,
+			COALESCE(s.last_sync_error, ''), s.last_synced_at, s.next_sync_at,
+			s.created_at, s.updated_at,
+			COUNT(DISTINCT n.id), COUNT(DISTINCT n.id) FILTER (WHERE n.health_status = 'healthy'),
+			COUNT(DISTINCT a.id)
+		FROM proxy_subscriptions s
+		LEFT JOIN proxy_subscription_nodes n ON n.subscription_id = s.id
+		LEFT JOIN accounts a ON a.subscription_proxy_node_id = n.id AND a.deleted_at IS NULL
+		WHERE s.id = $1
+		GROUP BY s.id
+	`, id)
+	var (
+		sub                    ProxySubscription
+		encrypted              string
+		includeRaw, excludeRaw []byte
+		currentID, previousID  sql.NullInt64
+		lastSync               sql.NullTime
+	)
+	if err := row.Scan(&sub.ID, &sub.Name, &encrypted, &sub.SyncIntervalMinutes,
+		&includeRaw, &excludeRaw, &sub.Enabled, &currentID, &previousID,
+		&sub.LastSyncStatus, &sub.LastSyncError, &lastSync, &sub.NextSyncAt,
+		&sub.CreatedAt, &sub.UpdatedAt, &sub.NodeCount, &sub.HealthyNodeCount,
+		&sub.AssignedAccountCount); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, "", ErrProxySubscriptionNotFound
+		}
+		return nil, "", err
+	}
+	applyNullableSubscriptionFields(&sub, currentID, previousID, lastSync)
+	if raw, err := s.encryptor.Decrypt(encrypted); err == nil {
+		sub.URLMasked = maskSubscriptionURL(raw)
+	}
+	sub.IncludeKeywords = parsePostgresTextArray(includeRaw)
+	sub.ExcludeKeywords = parsePostgresTextArray(excludeRaw)
+	return &sub, encrypted, nil
+}
+
+func (s *ProxySubscriptionService) List(ctx context.Context) ([]ProxySubscription, error) {
+	rows, err := s.db.QueryContext(ctx, "SELECT id FROM proxy_subscriptions ORDER BY id DESC")
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	result := make([]ProxySubscription, 0, len(ids))
+	for _, id := range ids {
+		sub, err := s.Get(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, *sub)
+	}
+	return result, rows.Err()
+}
+
+func (s *ProxySubscriptionService) Nodes(ctx context.Context, subscriptionID int64) ([]ProxySubscriptionNode, error) {
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT n.id, n.subscription_id, s.name, n.revision_id, n.display_name,
+			n.protocol, n.proxy_id, n.listen_port, n.health_status, n.latency_ms,
+			n.missing_sync_count, n.missing_since, n.last_checked_at, n.last_seen_at,
+			COUNT(a.id)
+		FROM proxy_subscription_nodes n
+		JOIN proxy_subscriptions s ON s.id = n.subscription_id
+		LEFT JOIN accounts a ON a.subscription_proxy_node_id = n.id AND a.deleted_at IS NULL
+		WHERE ($1 = 0 OR n.subscription_id = $1)
+		GROUP BY n.id, s.name
+		ORDER BY s.name, n.display_name
+	`, subscriptionID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	nodes := make([]ProxySubscriptionNode, 0)
+	for rows.Next() {
+		var node ProxySubscriptionNode
+		var latency sql.NullInt64
+		var missing, checked sql.NullTime
+		if err := rows.Scan(&node.ID, &node.SubscriptionID, &node.SubscriptionName,
+			&node.RevisionID, &node.DisplayName, &node.Protocol, &node.ProxyID,
+			&node.ListenPort, &node.HealthStatus, &latency, &node.MissingSyncCount,
+			&missing, &checked, &node.LastSeenAt, &node.AssignedAccountCount); err != nil {
+			return nil, err
+		}
+		if latency.Valid {
+			v := int(latency.Int64)
+			node.LatencyMs = &v
+		}
+		if missing.Valid {
+			node.MissingSince = &missing.Time
+		}
+		if checked.Valid {
+			node.LastCheckedAt = &checked.Time
+		}
+		nodes = append(nodes, node)
+	}
+	return nodes, rows.Err()
+}
+
+func applyNullableSubscriptionFields(sub *ProxySubscription, currentID, previousID sql.NullInt64, lastSync sql.NullTime) {
+	if currentID.Valid {
+		v := currentID.Int64
+		sub.CurrentRevisionID = &v
+	}
+	if previousID.Valid {
+		v := previousID.Int64
+		sub.PreviousRevisionID = &v
+	}
+	if lastSync.Valid {
+		v := lastSync.Time
+		sub.LastSyncedAt = &v
+	}
+}
