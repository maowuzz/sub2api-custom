diff --git a/backend/migrations/9000_custom_proxy_subscriptions.sql b/backend/migrations/9000_custom_proxy_subscriptions.sql
new file mode 100644
index 00000000..ec53f3bd
--- /dev/null
+++ b/backend/migrations/9000_custom_proxy_subscriptions.sql
@@ -0,0 +1,86 @@
+-- Managed proxy subscriptions. The high custom migration number avoids
+-- colliding with upstream's sequential migrations.
+
+CREATE TABLE IF NOT EXISTS proxy_subscriptions (
+    id BIGSERIAL PRIMARY KEY,
+    name VARCHAR(100) NOT NULL,
+    encrypted_url TEXT NOT NULL,
+    sync_interval_minutes INTEGER NOT NULL DEFAULT 360 CHECK (sync_interval_minutes BETWEEN 15 AND 10080),
+    include_keywords TEXT[] NOT NULL DEFAULT '{}',
+    exclude_keywords TEXT[] NOT NULL DEFAULT '{}',
+    enabled BOOLEAN NOT NULL DEFAULT TRUE,
+    current_revision_id BIGINT,
+    previous_revision_id BIGINT,
+    consecutive_sync_failures INTEGER NOT NULL DEFAULT 0,
+    last_sync_status VARCHAR(20) NOT NULL DEFAULT 'pending' CHECK (last_sync_status IN ('pending', 'syncing', 'success', 'error', 'degraded')),
+    last_sync_error TEXT,
+    last_synced_at TIMESTAMPTZ,
+    next_sync_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE TABLE IF NOT EXISTS proxy_subscription_revisions (
+    id BIGSERIAL PRIMARY KEY,
+    subscription_id BIGINT NOT NULL REFERENCES proxy_subscriptions(id) ON DELETE CASCADE,
+    encrypted_payload TEXT NOT NULL,
+    payload_sha256 CHAR(64) NOT NULL,
+    etag TEXT,
+    last_modified TEXT,
+    status VARCHAR(20) NOT NULL DEFAULT 'candidate' CHECK (status IN ('candidate', 'active', 'previous', 'failed')),
+    node_count INTEGER NOT NULL DEFAULT 0,
+    error_message TEXT,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    activated_at TIMESTAMPTZ
+);
+
+ALTER TABLE proxy_subscriptions
+    ADD CONSTRAINT proxy_subscriptions_current_revision_fk
+    FOREIGN KEY (current_revision_id) REFERENCES proxy_subscription_revisions(id) ON DELETE SET NULL;
+ALTER TABLE proxy_subscriptions
+    ADD CONSTRAINT proxy_subscriptions_previous_revision_fk
+    FOREIGN KEY (previous_revision_id) REFERENCES proxy_subscription_revisions(id) ON DELETE SET NULL;
+
+CREATE TABLE IF NOT EXISTS proxy_subscription_nodes (
+    id BIGSERIAL PRIMARY KEY,
+    subscription_id BIGINT NOT NULL REFERENCES proxy_subscriptions(id) ON DELETE CASCADE,
+    revision_id BIGINT NOT NULL REFERENCES proxy_subscription_revisions(id) ON DELETE RESTRICT,
+    stable_key CHAR(64) NOT NULL,
+    display_name VARCHAR(255) NOT NULL,
+    protocol VARCHAR(32) NOT NULL,
+    proxy_id BIGINT NOT NULL REFERENCES proxies(id) ON DELETE RESTRICT,
+    listen_port INTEGER NOT NULL CHECK (listen_port BETWEEN 20000 AND 29999),
+    inbound_username VARCHAR(100) NOT NULL,
+    inbound_password VARCHAR(100) NOT NULL,
+    health_status VARCHAR(20) NOT NULL DEFAULT 'unknown' CHECK (health_status IN ('unknown', 'healthy', 'unhealthy', 'offline')),
+    latency_ms INTEGER,
+    consecutive_failures INTEGER NOT NULL DEFAULT 0,
+    consecutive_successes INTEGER NOT NULL DEFAULT 0,
+    missing_sync_count INTEGER NOT NULL DEFAULT 0,
+    missing_since TIMESTAMPTZ,
+    last_checked_at TIMESTAMPTZ,
+    last_seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    UNIQUE (subscription_id, stable_key),
+    UNIQUE (proxy_id),
+    UNIQUE (listen_port)
+);
+
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS subscription_proxy_mode VARCHAR(10);
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS subscription_proxy_node_id BIGINT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS subscription_previous_proxy_id BIGINT;
+
+ALTER TABLE accounts ADD CONSTRAINT accounts_subscription_proxy_mode_check
+    CHECK (subscription_proxy_mode IS NULL OR subscription_proxy_mode IN ('manual', 'auto'));
+ALTER TABLE accounts ADD CONSTRAINT accounts_subscription_proxy_node_fk
+    FOREIGN KEY (subscription_proxy_node_id) REFERENCES proxy_subscription_nodes(id) ON DELETE SET NULL;
+ALTER TABLE accounts ADD CONSTRAINT accounts_subscription_previous_proxy_fk
+    FOREIGN KEY (subscription_previous_proxy_id) REFERENCES proxies(id) ON DELETE SET NULL;
+
+CREATE INDEX IF NOT EXISTS idx_proxy_subscriptions_due ON proxy_subscriptions(enabled, next_sync_at);
+CREATE INDEX IF NOT EXISTS idx_proxy_subscription_revisions_source ON proxy_subscription_revisions(subscription_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_proxy_subscription_nodes_health ON proxy_subscription_nodes(health_status, last_checked_at);
